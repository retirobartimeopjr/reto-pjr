---
import Layout from '../layouts/Layout.astro'
import Snowballs from '../components/Snowballs.astro'
import HomeHeader from '../components/home/HomeHeader.astro'
import AchievementsSection from '../components/AchievementsSection.astro'
import RankingSection from '../components/RankingSection.astro'
import TicketsSection from '../components/TicketsSection.astro'
import Countdown from '../components/Countdown.astro'
import Map from '../components/Map.astro'

const isLocked = true
---

<Layout title="Reto Bartimeo 2026">
  <div
    class="min-h-screen text-white overflow-x-hidden font-sans selection:bg-brand/30 relative"
    style={{
      backgroundImage:
        "linear-gradient(to bottom, rgba(100, 0, 16, 0.85), rgba(100, 0, 16, 0.6)), url('/foto.png')",
      backgroundSize: 'cover',
      backgroundPosition: 'center',
      backgroundAttachment: 'fixed',
      backgroundRepeat: 'no-repeat',
    }}
  >
    {/* Snow Effect Component */}
    <Snowballs />

    {/* Header with Login Button */}
    <HomeHeader />

    <main
      class="relative z-10 flex flex-col items-center justify-start w-full min-h-screen px-4 py-8 gap-8 md:gap-12"
    >
      {/* 1. Main Hero Block */}
      <div
        class="w-full max-w-4xl flex flex-col items-center gap-6 animate-fade-in-up mt-6 text-center"
      >
        <div class="relative group">
          <img
            src="/bartimeo.png"
            alt="Bartimeo"
            class="w-full max-w-[500px] md:max-w-[700px] object-contain drop-shadow-[0_0_35px_rgba(248,177,52,0.3)] animate-float relative z-10"
            style="width: 150%;"
          />
          {/* Flag Behind Effect */}
          <img
            src="/bartimeo-flag.png"
            alt="Flag"
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[140%] max-w-none opacity-30 blur-md -z-10 mix-blend-screen"
          />
        </div>

        <!-- Title increased 50% from text-4xl -> text-6xl for desktop -->
        <h1
          class="font-serif text-4xl md:text-6xl font-bold uppercase tracking-[0.2em] text-gold-texture leading-tight whitespace-normal md:whitespace-nowrap px-4"
        >
          "¡Señor, que vea!"
        </h1>

        <p
          class="text-white/90 text-lg md:text-xl font-light max-w-lg mx-auto leading-relaxed drop-shadow-md"
        >
          El camino comienza aquí.
        </p>
      </div>

      {/* Secondary Content Blocks - Bento Grid Layout */}
      <div class="w-full max-w-6xl animate-fade-in-up delay-100 px-2 lg:px-0 flex flex-col gap-6">
        <!-- Grid Container -->
        <!-- Mobile: Stacked (flex-col) -->
        <!-- Desktop: Grid with alternating sizes as requested -->
        <!-- Row 1: Large Left, Small Right -->
        <!-- Row 2: Small Left, Large Right -->

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 w-full">
          <!-- Row 1 Left: Large (Span 2) - Mis Logros -->
          <div id="section-achievements" class="lg:col-span-2 login-overlay-container h-full">
            <AchievementsSection isLocked={isLocked} />
          </div>

          <!-- Row 1 Right: Small (Span 1) - Ranking -->
          <div id="section-ranking" class="lg:col-span-1 login-overlay-container h-full">
            <RankingSection isLocked={isLocked} />
          </div>

          <!-- Row 2 Left: Small (Span 1) - Countdown & Tiempo Restante -->
          <!-- Making Countdown fit in a small box might be tight, let's wrap it in a card style -->
          <div
            class="lg:col-span-1 h-full bg-black/20 backdrop-blur-md border border-white/10 rounded-2xl p-6 flex flex-col items-center justify-center min-h-[300px]"
          >
            <Countdown />
          </div>

          <!-- Row 2 Right: Large (Span 2) - Available Rewards / Tickets -->
          <div id="section-tickets" class="lg:col-span-2 login-overlay-container h-full">
            <TicketsSection isLocked={isLocked} />
          </div>
        </div>

        {/* Map - Full Width (Alone) */}
        <section
          class="w-full rounded-2xl overflow-hidden border border-white/10 shadow-2xl relative mt-4"
        >
          <div
            class="bg-black/50 p-4 absolute top-0 left-0 w-full z-10 backdrop-blur-sm border-b border-white/10 lg:hidden pointer-events-none"
          >
            <p class="text-center text-xs text-white/70">Mapa de Parroquias</p>
          </div>
          {/* Render Map Component directly */}
          <Map />
        </section>
      </div>

      <footer class="text-white/30 text-[10px] font-light uppercase tracking-widest mt-10">
        &copy; 2026 Proyecto Bartimeo
      </footer>
    </main>
  </div>
</Layout>

<style>
  .text-gold-texture {
    background: linear-gradient(to bottom, #f8b134, #bf8418);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .animate-float {
    animation: float 4s ease-in-out infinite;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .delay-100 {
    animation-delay: 0.2s;
    opacity: 0;
    animation-fill-mode: forwards;
  }
</style>

<script>
  function checkLoginState() {
    const isLoggedIn = localStorage.getItem('bartimeo_user_logged_in') === 'true'
    if (isLoggedIn) {
      const blurContents = document.querySelectorAll('.login-blur-content')
      const overlays = document.querySelectorAll('.login-overlay-layer')

      blurContents.forEach((el) => {
        el.classList.remove('blur-md', 'select-none', 'pointer-events-none', 'opacity-50')
      })

      overlays.forEach((el) => {
        el.classList.add('hidden', 'pointer-events-none', 'opacity-0')
      })
    }
  }

  document.addEventListener('astro:page-load', () => {
    checkLoginState()
  })

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      checkLoginState()
    })
  } else {
    checkLoginState()
  }
</script>
