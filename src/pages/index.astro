---
import Layout from '../layouts/Layout.astro'
import Snowballs from '../components/Snowballs.astro'
import HomeHeader from '../components/home/HomeHeader.astro'
import AchievementsSection from '../components/AchievementsSection.astro'
import RankingSection from '../components/RankingSection.astro'
import TicketsSection from '../components/TicketsSection.astro'
import Countdown from '../components/Countdown.astro'
import Map from '../components/Map.astro'

// We initially render as locked.
// Unlock logic happens on client side via JS since no backend/cookies are being used for this demo.
const isLocked = true
---

<Layout title="Reto Bartimeo 2026">
  <div
    class="min-h-screen text-white overflow-x-hidden font-sans selection:bg-brand/30 relative"
    style={{
      backgroundImage:
        "linear-gradient(to bottom, rgba(100, 0, 16, 0.85), rgba(100, 0, 16, 0.6)), url('/foto.png')",
      backgroundSize: 'cover',
      backgroundPosition: 'center',
      backgroundAttachment: 'fixed',
      backgroundRepeat: 'no-repeat',
    }}
  >
    {/* Snow Effect Component */}
    <Snowballs />

    {/* Header with Login Button */}
    <HomeHeader />

    <main
      class="relative z-10 flex flex-col items-center justify-start w-full min-h-screen px-4 py-10 gap-16"
    >
      {/* 1. Main Hero Block */}
      <div
        class="w-full max-w-md flex flex-col items-center gap-8 animate-fade-in-up mt-10 text-center"
      >
        <div class="relative group">
          {/* Logo with Glow */}
          <img
            src="/bartimeo.png"
            alt="Bartimeo"
            class="w-106 md:w-135 object-contain drop-shadow-[0_0_35px_rgba(248,177,52,0.3)] animate-float relative z-10"
          />
          {/* Flag Behind Effect */}
          <img
            src="/bartimeo-flag.png"
            alt="Flag"
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[140%] max-w-none opacity-30 blur-md -z-10 mix-blend-screen"
          />
        </div>

        <h1
          class="font-serif text-3xl md:text-4xl font-bold uppercase tracking-[0.2em] text-gold-texture leading-tight whitespace-nowrap"
        >
          "¡Señor, que vea!"
        </h1>

        <p class="text-white/90 text-lg font-light max-w-xs mx-auto leading-relaxed drop-shadow-md">
          El camino comienza aquí.
        </p>
      </div>

      {/* Secondary Content Blocks (Locked by default) */}
      <div class="w-full max-w-5xl flex flex-col gap-12 animate-fade-in-up delay-100">
        {/* Achievements */}
        <div id="section-achievements" class="login-overlay-container">
          <AchievementsSection isLocked={isLocked} />
        </div>

        {/* Ranking */}
        <div id="section-ranking" class="login-overlay-container">
          <RankingSection isLocked={isLocked} />
        </div>

        {/* Countdown */}
        <Countdown />

        {/* Available Rewards / Tickets */}
        <div id="section-tickets" class="login-overlay-container">
          <TicketsSection isLocked={isLocked} />
        </div>

        {/* Map */}
        <section
          class="w-full rounded-2xl overflow-hidden border border-white/10 shadow-2xl relative"
        >
          <div
            class="bg-black/50 p-4 absolute top-0 left-0 w-full z-10 backdrop-blur-sm border-b border-white/10 lg:hidden pointer-events-none"
          >
            <p class="text-center text-xs text-white/70">Mapa de Parroquias</p>
          </div>
          {/* Render Map Component directly */}
          <Map />
        </section>
      </div>

      <footer class="text-white/30 text-[10px] font-light uppercase tracking-widest mt-10">
        &copy; 2026 Proyecto Bartimeo
      </footer>
    </main>
  </div>
</Layout>

<style>
  .text-gold-texture {
    background: linear-gradient(to bottom, #f8b134, #bf8418);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  /* Floating Animation */
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .animate-float {
    animation: float 4s ease-in-out infinite;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .delay-100 {
    animation-delay: 0.2s;
    opacity: 0;
    animation-fill-mode: forwards;
  }
</style>

<audio id="bg-music" src="/song.mp3" preload="auto"></audio>

<script>
  function setupAudio() {
    const audio = document.getElementById('bg-music') as HTMLAudioElement
    const playAudio = async () => {
      try {
        await audio.play()
        audio.volume = 0.5
      } catch (err) {}
    }
    document.addEventListener(
      'click',
      () => {
        if (audio.paused) playAudio()
      },
      { once: true }
    )
    playAudio()
  }

  function checkLoginState() {
    const isLoggedIn = localStorage.getItem('bartimeo_user_logged_in') === 'true'
    if (isLoggedIn) {
      // Unlock Everything
      // This requires selecting inner components within the sections
      // The LoginOverlay component has classes .login-blur-content and .login-overlay-layer
      // We need to target them globally.

      const blurContents = document.querySelectorAll('.login-blur-content')
      const overlays = document.querySelectorAll('.login-overlay-layer')

      blurContents.forEach((el) => {
        el.classList.remove('blur-md', 'select-none', 'pointer-events-none', 'opacity-50')
      })

      overlays.forEach((el) => {
        el.classList.add('hidden', 'pointer-events-none', 'opacity-0')
      })
    }
  }

  document.addEventListener('astro:page-load', () => {
    setupAudio()
    checkLoginState()
  })

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setupAudio()
      checkLoginState()
    })
  } else {
    setupAudio()
    checkLoginState()
  }
</script>
