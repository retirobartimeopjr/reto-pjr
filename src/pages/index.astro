---
import Layout from '../layouts/Layout.astro'
import HomeHeader from '../components/home/HomeHeader.astro'
---

<Layout title="Portal Principal">
  <HomeHeader />

  <main
    class="min-h-screen pt-24 pb-12 px-4 flex flex-col items-center justify-center relative z-10 overflow-hidden"
  >
    <!-- Background Video -->
    <div class="fixed inset-0 z-[-2] overflow-hidden bg-black">
      <video autoplay loop muted playsinline class="w-full h-full object-cover opacity-50">
        <source src="/videos/bartifondo_bg.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Background Overlay -->
    <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
      <div
        class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-[#f8b134]/10 blur-[100px] rounded-full"
      >
      </div>
      <div
        class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] bg-[#bf8418]/10 blur-[100px] rounded-full"
      >
      </div>
      <div class="absolute inset-0 bg-[url('/noise.svg')] opacity-30 mix-blend-overlay"></div>
    </div>

    <!-- Script de Redirección Automática (Client-Side) -->
    <script is:inline>
      ;(function () {
        try {
          const userStateRaw = localStorage.getItem('bartimeo:user')
          if (userStateRaw) {
            const userState = JSON.parse(userStateRaw)
            if (userState.isAuthenticated === 'true') {
              window.location.replace('/reto')
            }
          }
        } catch (e) {
          console.error('Error reading localStorage for auto-redirect', e)
        }
      })()
    </script>

    <div class="text-center mb-12 animate-fade-in-up">
      <h1
        class="text-4xl md:text-6xl font-serif font-black mb-4 tracking-tight drop-shadow-lg text-white"
      >
        ¿A dónde quieres ir?
      </h1>
      <p
        class="text-white/90 text-lg md:text-xl max-w-lg mx-auto leading-relaxed font-medium drop-shadow-md"
      >
        Selecciona tu destino para continuar tu experiencia en la Parroquia Jesucristo Redentor.
      </p>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10 w-full max-w-4xl animate-fade-in-up"
      style="animation-delay: 0.2s;"
    >
      <!-- BOTÓN EL RETO -->
      <a
        href="/reto"
        class="animate-bounce-soft group relative block w-full aspect-[4/3] rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(248,177,52,0.3)] transition-all duration-300 hover:-translate-y-4 hover:scale-105 active:scale-90 border-[2px] border-[#f8b134]/50 hover:border-[#f8b134] isolate [mask-image:-webkit-radial-gradient(white,black)]"
      >
        <!-- Fondo Sólido/Glassmorphism Más Fuerte -->
        <div
          class="absolute inset-0 bg-gradient-to-br from-[#dca336]/75 to-[#bf8418]/65 backdrop-blur-xl z-0"
        >
        </div>
        <div class="absolute inset-0 bg-[url('/noise.svg')] opacity-30 mix-blend-overlay z-0"></div>

        <!-- Imagen Sutil de Fondo (Trofeo) -->
        <div
          class="absolute inset-0 z-0 flex items-center justify-center opacity-40 group-hover:opacity-60 transition-opacity duration-500 transform group-hover:scale-110"
        >
          <img
            src="/trofeo.webp"
            alt="Trofeo"
            class="w-[80%] h-[80%] object-contain drop-shadow-2xl mix-blend-luminosity"
          />
        </div>

        <!-- Glow hover -->
        <div
          class="absolute inset-0 bg-gradient-to-tr from-[#f8b134]/0 via-[#f8b134]/30 to-[#f8b134]/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-0 pointer-events-none"
        >
        </div>

        <div class="relative z-10 h-full flex flex-col items-center justify-center p-6 text-center">
          <!-- Reloj Militar Granate (Absolute para no descentrar) -->
          <div class="absolute top-8 left-0 w-full flex flex-col items-center justify-center pointer-events-none z-20">
            <div id="reto-clock-label" class="text-xs md:text-sm text-[#8b0000] uppercase tracking-[0.2em] font-black opacity-0 transition-opacity duration-500 mb-1 drop-shadow-sm" style="text-shadow: 0 0 4px rgba(139,0,0,0.3);">
              INICIA EN
            </div>
            <div 
              id="reto-digital-clock" 
              class="font-mono text-xl md:text-2xl font-bold text-[#8b0000] tracking-[0.1em] opacity-0 transition-opacity duration-500"
              style="text-shadow: 0 0 8px rgba(139,0,0,0.4);"
            >
              00:00:00:00
            </div>
          </div>

          <h2
            class="text-5xl md:text-7xl font-serif font-black text-white tracking-tight drop-shadow-[0_6px_12px_rgba(0,0,0,0.8)] transform group-hover:scale-110 transition-transform duration-300"
          >
            El Reto
          </h2>
        </div>
      </a>

      <!-- BOTÓN EL RETIRO -->
      <a
        href="/retiro"
        class="animate-bounce-soft-delayed group relative block w-full aspect-[4/3] rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.4)] transition-all duration-300 hover:-translate-y-4 hover:scale-105 active:scale-90 border-[2px] border-white/30 hover:border-white/80 isolate [mask-image:-webkit-radial-gradient(white,black)]"
      >
        <!-- Ribbon Ultimos Cupos -->
        <div class="absolute top-0 right-0 z-30 w-32 h-32 overflow-hidden pointer-events-none">
          <div class="absolute top-10 -right-8 w-48 text-center origin-center transform rotate-45 bg-gradient-to-r from-[#f8b134] via-[#ffe082] to-[#bf8418] text-[#3d000a] font-black text-xs md:text-sm py-1 shadow-xl border-y border-white/60 uppercase tracking-widest drop-shadow-lg">
            ¡Últimos Cupos!
          </div>
        </div>
        <!-- Fondo Sólido/Glassmorphism Más Fuerte -->
        <div
          class="absolute inset-0 bg-gradient-to-br from-[#640010]/75 to-[#3d000a]/65 backdrop-blur-xl z-0"
        >
        </div>
        <div class="absolute inset-0 bg-[url('/noise.svg')] opacity-30 mix-blend-overlay z-0"></div>

        <!-- Imagen Sutil de Fondo (Sagrado Corazón) -->
        <div
          class="absolute inset-0 z-0 flex items-center justify-center opacity-40 group-hover:opacity-60 transition-opacity duration-500 transform group-hover:scale-110"
        >
          <img
            src="/sagrado-coraz-n-de-jes-s-e1464966918869_c.webp"
            alt="Sagrado Corazón"
            class="w-[80%] h-[80%] object-contain drop-shadow-2xl mix-blend-luminosity rounded-full"
          />
        </div>

        <!-- Glow hover -->
        <div
          class="absolute inset-0 bg-gradient-to-tr from-white/0 via-white/10 to-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-0 pointer-events-none"
        >
        </div>

        <div class="relative z-10 h-full flex items-center justify-center p-6 text-center">
          <h2
            class="text-5xl md:text-7xl font-serif font-black text-white tracking-tight drop-shadow-[0_6px_12px_rgba(0,0,0,0.8)] transform group-hover:scale-110 transition-transform duration-300"
          >
            El Retiro
          </h2>
        </div>
      </a>
    </div>
    <script>
      async function initRetoClock() {
        try {
          const res = await fetch('/api/appConfig')
          if (res.ok) {
            const data = await res.json()
            const startDate = data.challenge_start_time ? new Date(data.challenge_start_time).getTime() : 0
            const endDate = data.challenge_end_time ? new Date(data.challenge_end_time).getTime() : new Date('2026-03-19T18:00:00').getTime()
            startRetoClock(startDate, endDate)
          }
        } catch(e) {
          console.error('Error fetching config', e)
        }
      }

      function startRetoClock(startDate: number, endDate: number) {
        const clockEl = document.getElementById('reto-digital-clock')
        const labelEl = document.getElementById('reto-clock-label')
        if (!clockEl || !labelEl) return

        const updateClock = () => {
          const now = new Date().getTime()
          
          let targetDate = 0;

          if (startDate > 0 && now < startDate) {
              targetDate = startDate;
              labelEl.innerText = "INICIA EN";
          } else if (now < endDate) {
              targetDate = endDate;
              labelEl.innerText = "FINALIZA EN";
          } else {
              clockEl.innerText = "00:00:00:00"
              labelEl.innerText = "EL RETO HA TERMINADO"
              clockEl.classList.remove('opacity-0')
              labelEl.classList.remove('opacity-0')
              return true 
          }

          clockEl.classList.remove('opacity-0')
          labelEl.classList.remove('opacity-0')

          const distance = targetDate - now

          const days = Math.floor(distance / (1000 * 60 * 60 * 24))
          const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))
          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60))
          const seconds = Math.floor((distance % (1000 * 60)) / 1000)

          clockEl.innerText = `${days.toString().padStart(2, '0')}:${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`
          
          return false
        }

        if (updateClock()) return; 

        const interval = setInterval(() => {
          if (updateClock()) {
            clearInterval(interval)
          }
        }, 1000)
      }

      initRetoClock()
    </script>
  </main>
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes bounceSoft {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-8px) scale(1.02);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-bounce-soft {
    animation: bounceSoft 3s ease-in-out infinite;
  }

  .animate-bounce-soft-delayed {
    animation: bounceSoft 3s ease-in-out infinite;
    animation-delay: 1.5s;
  }
</style>
