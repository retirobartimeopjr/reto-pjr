---
import AchievementsSection from '../components/AchievementsSection.astro'
import BartiPregunta from '../components/BartiPregunta'
import Countdown from '../components/Countdown.astro'
import Dashboard from '../components/Dashboard'
import Leaderboard from '../components/Leaderboard'
import Map from '../components/Map.astro'
import Referidos from '../components/Referidos'
import Snowballs from '../components/Snowballs.astro'
import HomeHeader from '../components/home/HomeHeader.astro'
import Layout from '../layouts/Layout.astro'

const isLocked = true
---

<Layout title="Reto Bartimeo 2026">
  <div
    class="min-h-screen text-white overflow-x-hidden font-sans selection:bg-brand/30 relative"
    style={{
      backgroundImage:
        "linear-gradient(to bottom, rgba(100, 0, 16, 0.85), rgba(100, 0, 16, 0.6)), url('/foto.png')",
      backgroundSize: 'cover',
      backgroundPosition: 'center',
      backgroundAttachment: 'fixed',
      backgroundRepeat: 'no-repeat',
    }}
  >
    {/* Snow Effect Component */}
    <Snowballs />

    {/* Header with Login Button */}
    <HomeHeader />

    <main
      class="relative z-10 flex flex-col items-center justify-start w-full min-h-screen px-4 py-8 gap-8 md:gap-12"
    >
      {/* 1. Main Hero Block */}
      <div
        class="w-full max-w-4xl flex flex-col items-center gap-6 animate-fade-in-up mt-6 text-center"
      >
        <div class="relative group w-full flex justify-center">
          <img
            src="/bartimeo.png"
            alt="Bartimeo"
            class="w-full max-w-[300px] md:max-w-[700px] object-contain drop-shadow-[0_0_35px_rgba(248,177,52,0.3)] animate-float relative z-10 mx-auto"
            style="width: 150%;"
          />
          {/* Flag Behind Effect */}
          <img
            src="/bartimeo-flag.png"
            alt="Flag"
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[140%] max-w-none opacity-30 blur-md -z-10 mix-blend-screen pointer-events-none"
          />
        </div>

        <h1
          class="font-serif text-4xl md:text-6xl font-bold uppercase tracking-[0.2em] text-gold-texture leading-tight whitespace-normal md:whitespace-nowrap px-4"
        >
          "¡Señor, que vea!"
        </h1>

        <p
          class="text-white/90 text-lg md:text-xl font-light max-w-lg mx-auto leading-relaxed drop-shadow-md"
        >
          El camino comienza aquí.
        </p>

        {/* CTA Button with Arrow */}
        <div class="flex flex-col items-center gap-2 mt-8 z-20">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-8 w-8 text-[#f8b134] animate-bounce"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
          <a
            href="https://forms.gle/HMvueg96JV3gqNmB6"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 bg-gradient-to-r from-[#f8b134] to-[#bf8418] hover:from-[#fbd07e] hover:to-[#dca336] text-[#3d0000] font-bold text-xl rounded-full shadow-[0_0_20px_rgba(248,177,52,0.4)] hover:shadow-[0_0_30px_rgba(248,177,52,0.6)] transform hover:scale-105 transition-all duration-300 animate-bounce cursor-pointer flex items-center gap-3"
          >
            <span>¡Inscríbete AQUÍ al IV Retiro!</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
        </div>
      </div>

      {/* DASHBOARD SECTION (Visible only if logged in - handled by component) */}
      <div class="w-full max-w-6xl animate-fade-in-up delay-100">
        <Dashboard client:load />
      </div>

      {/* Secondary Content Blocks - Bento Grid Layout */}
      <div class="w-full max-w-6xl animate-fade-in-up delay-100 px-2 lg:px-0 flex flex-col gap-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 w-full">
          {/* LEADERBOARD (Public) */}
          <div class="lg:col-span-2 h-full">
            <Leaderboard client:load />
          </div>

          {/* COUNTDOWN & ACTIONS (Public/Private) */}
          <div class="lg:col-span-1 flex flex-col gap-6">
            {/* Countdown */}
            <div
              class="bg-black/20 backdrop-blur-md border border-white/10 rounded-2xl p-6 flex flex-col items-center justify-center"
            >
              <Countdown />
            </div>

            {/* GAME & REFERRALS (Interactive) */}
            <div class="flex flex-col gap-4">
              <BartiPregunta client:load />
            </div>
          </div>

          {/* REFERRAL SECTION (Full Width in Grid or separate) */}
          <div class="lg:col-span-3">
            <Referidos client:load />
          </div>
        </div>

        {/* Video Section */}
        <section
          class="w-full rounded-2xl overflow-hidden border border-white/10 shadow-2xl relative mt-4 bg-black"
        >
          <video
            class="w-full h-auto max-h-[600px] object-contain mx-auto"
            controls
            playsinline
            poster="/bartimeo.png"
          >
            <source src="/Download.mp4" type="video/mp4" />
            Tu navegador no soporta videos.
          </video>
        </section>

        {/* Map - Full Width */}
        <section
          class="w-full rounded-2xl overflow-hidden border border-white/10 shadow-2xl relative mt-4"
        >
          <Map />
        </section>

        {/* HIDDEN / DISABLED SECTIONS (As per user request "lo demas queda oculto") */}
        {/* Achievements & Tickets - Wrapped in a Blur/Locked Container visually */}
        <div
          class="w-full opacity-50 grayscale pointer-events-none relative overflow-hidden rounded-2xl border border-white/5 mt-4"
        >
          <div
            class="absolute inset-0 bg-black/60 z-10 flex items-center justify-center backdrop-blur-sm"
          >
            <p
              class="text-white/40 font-serif uppercase tracking-widest text-sm border border-white/20 px-4 py-2 rounded-full"
            >
              Próximamente
            </p>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 p-6">
            <div class="lg:col-span-2">
              <AchievementsSection isLocked={true} />
            </div>
            <div class="lg:col-span-1">
              {/* Placeholder for old ranking space */}
              <div class="h-64 bg-white/5 rounded-xl"></div>
            </div>
          </div>
        </div>
      </div>

      <footer class="text-white/30 text-[10px] font-light uppercase tracking-widest mt-10">
        &copy; 2026 Proyecto Bartimeo
      </footer>
    </main>
  </div>
</Layout>

<style>
  .text-gold-texture {
    background: linear-gradient(to bottom, #f8b134, #bf8418);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .animate-float {
    animation: float 4s ease-in-out infinite;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .delay-100 {
    animation-delay: 0.2s;
    opacity: 0;
    animation-fill-mode: forwards;
  }
</style>
