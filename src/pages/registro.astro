---
import Layout from '../layouts/Layout.astro'
import HomeButton from '../components/HomeButton.astro'
import Snowballs from '../components/Snowballs.astro'
---

<Layout title="Ingreso | Reto Bartimeo">
  <div
    class="min-h-screen text-white relative flex flex-col items-center justify-center overflow-hidden"
    style={{
      backgroundImage:
        "linear-gradient(to bottom, rgba(100, 0, 16, 0.95), rgba(70, 0, 10, 0.95)), url('/foto.png')",
      backgroundSize: 'cover',
      backgroundPosition: 'center',
    }}
  >
    <Snowballs />

    <HomeButton />

    <main class="w-full max-w-md px-6 relative z-10 flex flex-col gap-8 animate-fade-in-up">
      <header class="text-center space-y-4">
        <div class="relative inline-block">
          <img
            src="/bartimeo.png"
            alt="Bartimeo"
            class="w-80 md:w-96 mx-auto drop-shadow-[0_0_20px_rgba(248,177,52,0.3)]"
          />
        </div>
        <!-- Title increased 50% from text-3xl -> text-5/6xl responsive -->
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-[#f8b134] leading-tight">
          Bienvenido de nuevo
        </h1>
        <p class="text-white/60 text-sm">Ingresa tus datos para continuar tu camino.</p>
      </header>

      <article
        class="w-full bg-black/40 backdrop-blur-xl border border-white/10 rounded-2xl p-8 shadow-2xl relative overflow-hidden"
      >
        <!-- Login Form -->
        <form id="login-form-page" class="flex flex-col gap-6" action="#" method="POST">
          <div class="space-y-2">
            <label
              for="email"
              class="text-xs uppercase tracking-wider text-white/70 font-bold ml-1"
            >
              Usuario
            </label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="tucorreo@ejemplo.com"
              class="w-full px-4 py-3 bg-black/30 border border-white/10 rounded-xl text-white placeholder-white/30 focus:outline-none focus:border-[#f8b134]/50 focus:bg-black/50 transition-all duration-300"
              required
            />
          </div>

          <div class="space-y-2">
            <label for="code" class="text-xs uppercase tracking-wider text-white/70 font-bold ml-1">
              Código de Acceso
            </label>
            <input
              type="text"
              id="code"
              name="code"
              placeholder="• • • • • •"
              class="w-full px-4 py-3 bg-black/30 border border-white/10 rounded-xl text-white placeholder-white/30 focus:outline-none focus:border-[#f8b134]/50 focus:bg-black/50 transition-all duration-300 tracking-[0.5em] text-center font-mono text-lg"
              required
            />
          </div>

          <button
            type="submit"
            class="mt-4 w-full px-6 py-4 bg-gradient-to-r from-[#f8b134] to-[#cfa045] hover:from-[#ffc45c] hover:to-[#eeb045] text-[#640010] font-black uppercase tracking-wider rounded-xl transition-all duration-300 transform active:scale-[0.98] shadow-lg flex items-center justify-center gap-2"
          >
            <span>Iniciar Sesión</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                clip-rule="evenodd"></path>
            </svg>
          </button>
        </form>
      </article>
    </main>
  </div>
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
  }
</style>

<script>
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupLogin)
  } else {
    setupLogin()
  }
  document.addEventListener('astro:page-load', setupLogin)

  function setupLogin() {
    const form = document.getElementById('login-form-page')
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault()
        // Demo Logic: Set user as logged in via localStorage
        localStorage.setItem('bartimeo_user_logged_in', 'true')

        // Redirect to home
        window.location.href = '/'
      })
    }
  }
</script>
