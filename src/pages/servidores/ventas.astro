---
import '../../styles/global.css';
import VentasServidores from '../../components/VentasServidores';
---
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
<meta charset="UTF-8">
<title>Ventas | Servidores Bartimeo</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Titan+One&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/src/styles/global.css" />
<style>
  :root{
    --night: #1a0a0d;
    --night-2: #2d1117;
    --gold: #f8b134;
    --gold-soft: #ffcc66;
    --parchment: #640010;
    --wine: #4a000a;
    --wine-soft: #300006;
    --ink: #ffffff;
    --ink-soft: rgba(255,255,255,0.8);
    --line: rgba(255,255,255,0.15);
    --brand-glow: rgba(248,177,52,0.6);
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
    background-image: radial-gradient(circle at top center, rgba(160, 20, 30, 0.7) 0%, rgba(80, 0, 15, 0.9) 70%), url('/bartimeo-bg.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    min-height: 100vh;
  }

  /* Nav Tabs */
  .servidores-nav {
    display: flex;
    justify-content: center;
    gap: 12px;
    padding: 24px;
    background: rgba(0,0,0,0.5);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(15px);
  }
  .nav-tab {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--ink-soft);
    padding: 10px 24px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }
  .nav-tab.active {
    background: var(--gold);
    color: #000;
    border-color: var(--gold);
    box-shadow: 0 0 15px rgba(248,177,52,0.4);
  }
  .nav-tab:hover:not(.active) {
    background: rgba(255,255,255,0.1);
    color: var(--ink);
  }
</style>
</head>
<body>

<nav class="servidores-nav">
  <a href="/servidores" class="nav-tab">Itinerario 2026</a>
  <a href="/servidores" class="nav-tab">Metas Reto</a>
  <a href="/servidores/ventas" class="nav-tab active">Ventas</a>
</nav>

<main class="w-full pt-10 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto mb-8 text-center">
    <h1 class="font-['Titan_One'] text-4xl sm:text-5xl text-white mb-2 tracking-wide" style={{ textShadow: "2px 4px 0px rgba(0,0,0,0.8), 0 0 20px rgba(248,177,52,0.4)" }}>
      Gestión de Ventas
    </h1>
    <p class="text-white/70 font-['Inter']">Control de reservas para Arroz con Pollo y Tamales.</p>
  </div>

  <VentasServidores client:load />
</main>

</body>
</html>
