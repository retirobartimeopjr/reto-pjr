---

import BartiPregunta from '../components/BartiPregunta'
import Countdown from '../components/Countdown.astro'
import Dashboard from '../components/Dashboard'
import EndOfChallengeModal from '../components/EndOfChallengeModal'
import Leaderboard from '../components/Leaderboard'
import Map from '../components/Map.astro'
import PromoSection from '../components/PromoSection'
import PublicActions from '../components/PublicActions'
import Referidos from '../components/Referidos'
import RegistrationButton from '../components/RegistrationButton'
import Snowballs from '../components/Snowballs.astro'
import HomeHeader from '../components/home/HomeHeader.astro'
import Layout from '../layouts/Layout.astro'

const isLocked = true;
---

<Layout title="Reto Bartimeo 2026">
  {/* SPLASH SCREEN INTRO */}
  <div id="intro-splash" class="fixed inset-0 z-[100] flex items-center justify-center bg-[#3d000a] transition-colors duration-[2000ms] cursor-pointer">
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-8">
      <img src="/bartimeo-logo.png" id="intro-splash-logo" class="w-[80vw] md:w-[60vw] max-w-[500px] h-auto object-contain drop-shadow-[0_0_30px_rgba(248,177,52,0.5)] origin-center transition-all duration-[2000ms] ease-in-out" />
      <div id="splash-hint" class="flex items-center gap-2 text-white text-base md:text-lg tracking-widest animate-pulse font-bold drop-shadow-[0_0_15px_rgba(248,177,52,0.8)] transition-opacity duration-300 bg-black/50 px-8 py-3 rounded-full border border-[#f8b134]/50 backdrop-blur-md mt-4">
        <span class="text-xl">👆</span>
        <span>TOCA PARA ENTRAR</span>
      </div>
    </div>
  </div>

  {/* Fondo fijo para evitar problemas de scroll en móvil */}
  <div
    class="fixed inset-0 w-full h-full -z-10"
    style={{
      backgroundImage:
        "linear-gradient(to bottom, rgba(100, 0, 16, 0.85), rgba(100, 0, 16, 0.6)), url('/foto.png')",
      backgroundSize: 'cover',
      backgroundPosition: 'center',
      backgroundRepeat: 'no-repeat',
    }}
  >
  </div>

  <div class="min-h-screen text-white overflow-x-hidden font-sans selection:bg-brand/30 relative">
    {/* Snow Effect Component */}
    <Snowballs />

    {/* Header with Login Button */}
    <HomeHeader />

    <main
      class="relative z-10 flex flex-col items-center justify-start w-full min-h-screen px-4 py-8 gap-8 md:gap-12"
    >
      {/* 1. Main Hero Block */}
      <div
        class="w-full max-w-4xl flex flex-col items-center gap-6 animate-fade-in-up mt-6 text-center relative"
      >
        {/* Flag Behind Effect (Profundidad) */}
        <div class="relative w-full flex justify-center items-center mb-4 min-h-[150px] md:min-h-[200px]">
            <img
              src="/bartimeo-flag.png"
              alt="Flag"
              class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80%] md:w-[60%] max-w-[400px] opacity-40 blur-sm mix-blend-screen pointer-events-none drop-shadow-[0_0_20px_rgba(248,177,52,0.3)]"
            />
            <div class="relative z-10 flex flex-col items-center gap-3 mt-4">
                <div class="animate-float">
                  <img
                    src="/logosingle.png"
                    id="hero-logo-single"
                    alt="Logo Single"
                    class="w-24 md:w-32 h-auto object-contain drop-shadow-[0_0_15px_rgba(255,255,255,0.4)] opacity-0 transition-opacity duration-300"
                  />
                </div>
                <div class="bg-gradient-to-r from-[#f8b134] via-[#fbd07e] to-[#bf8418] text-[#3d000a] font-serif text-xl md:text-3xl px-6 py-1.5 rounded-full shadow-[0_0_35px_rgba(248,177,52,0.9)] border border-[#ffda8c]/50 transform hover:scale-105 transition-transform tracking-wide mt-2">
                  Reto Bartimeo 2.0
                </div>
            </div>
        </div>

        <h1
          class="text-white/90 text-2xl md:text-4xl font-serif font-light max-w-lg mx-auto leading-relaxed drop-shadow-md"
        >
          El camino comienza aquí.
        </h1>

        {/* CTA Button with Arrow - Now controlled by React Component */}
        <RegistrationButton client:only="react" />
      </div>

      {/* PROMO SECTION */}
      <PromoSection client:load />

      {/* DASHBOARD SECTION (Visible only if logged in - handled by component) */}
      <div class="w-full max-w-6xl animate-fade-in-up delay-100">
        <Dashboard client:load />
      </div>

      {/* Secondary Content Blocks - Bento Grid Layout */}
      <div class="w-full max-w-6xl animate-fade-in-up delay-100 px-2 lg:px-0 flex flex-col gap-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 w-full">
          {/* LEADERBOARD (Public) */}
          <div class="order-2 lg:order-1 lg:col-span-2 h-full">
            <Leaderboard client:load />
          </div>

          {/* COUNTDOWN & ACTIONS (Public/Private) */}
          <div class="order-1 lg:order-2 lg:col-span-1 flex flex-col gap-6">
            {/* Countdown */}
            <div
              class="bg-black/20 backdrop-blur-md border border-white/10 rounded-2xl p-6 flex flex-col items-center justify-center"
            >
              <Countdown />
            </div>

            {/* GAME & REFERRALS (Interactive) */}
            <div class="flex flex-col gap-4">
              <PublicActions client:load />
              <BartiPregunta client:load />
            </div>
          </div>

          {/* REFERRAL SECTION (Full Width in Grid or separate) */}
          <div class="lg:col-span-3">
            <Referidos client:load />
          </div>
        </div>

        {/* Map - Full Width */}
        <section
          class="w-full rounded-2xl overflow-hidden border border-white/10 shadow-2xl relative mt-4"
        >
          <Map />
        </section>

      </div>

      <footer
        class="flex flex-col items-center justify-center gap-4 text-white/80 text-[10px] font-light uppercase tracking-widest mt-12 mb-16"
      >
        <img
          src="/bartimeo.png"
          alt="Reto Bartimeo 2026"
          class="w-32 h-auto drop-shadow-[0_0_10px_rgba(255,255,255,0.6)]"
        />
        <p>Reto Bartimeo 2026</p>
        
        {/* Help Button */}
        <a 
          href="https://wa.me/573123415728?text=Hola%20Jesus%20:)%20Necesito%20ayuda%20con%20el%20Reto%20Bartimeo.%20Muchas%20gracias." 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center gap-2 bg-[#25D366] hover:bg-[#20b858] text-white px-5 py-2 rounded-xl font-bold text-sm transition-all shadow-[0_0_15px_rgba(37,211,102,0.2)] hover:shadow-[0_0_20px_rgba(37,211,102,0.4)] mt-4 capitalize"
          style="text-transform: none;"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.662-2.06-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
          </svg>
          Solicitar Ayuda
        </a>
      </footer>
    </main>
  </div>
  <EndOfChallengeModal client:load />
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    if (window.location.pathname !== '/reto' && window.location.pathname !== '/reto/') return;

    const splash = document.getElementById('intro-splash');
    const splashLogo = document.getElementById('intro-splash-logo');
    const heroLogo = document.getElementById('hero-logo-single');
    const hint = document.getElementById('splash-hint');
    const bgMusic = document.getElementById('bg-music') as HTMLAudioElement;

    if (!splash || !splashLogo || !heroLogo) return;

    const startAnimation = () => {
      if (splash.classList.contains('animating')) return;
      splash.classList.add('animating');

      if (hint) hint.style.opacity = '0';

      const targetRect = heroLogo.getBoundingClientRect();
      const splashRect = splashLogo.getBoundingClientRect();

      const scale = targetRect.height / splashRect.height;
      const targetCenterX = targetRect.left + targetRect.width / 2;
      const targetCenterY = targetRect.top + targetRect.height / 2;
      const splashCenterX = splashRect.left + splashRect.width / 2;
      const splashCenterY = splashRect.top + splashRect.height / 2;

      const tx = targetCenterX - splashCenterX;
      const ty = targetCenterY - splashCenterY;

      splashLogo.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      splash.style.backgroundColor = 'transparent';
      splash.style.pointerEvents = 'none';

      setTimeout(() => {
        splash.style.opacity = '0';
        heroLogo.classList.remove('opacity-0');
        heroLogo.classList.add('animate-bounce-short');
        
        setTimeout(() => splash.remove(), 300);
      }, 2000);
    };

    if (bgMusic) {
      if (!bgMusic.paused && bgMusic.currentTime > 0) {
        startAnimation();
      } else {
        bgMusic.addEventListener('play', startAnimation, { once: true });
        splash.addEventListener('click', () => {
          bgMusic.play().catch(console.error);
        });
      }
    } else {
      startAnimation();
    }
  });
</script>

<style>
  .text-gold-texture {
    background: linear-gradient(to bottom, #f8b134, #bf8418);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .animate-float {
    animation: float 4s ease-in-out infinite;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .delay-100 {
    animation-delay: 0.2s;
    opacity: 0;
    animation-fill-mode: forwards;
  }

  @keyframes bounceShort {
    0% { transform: translateY(0) scale(1); }
    40% { transform: translateY(-30px) scale(1.15); }
    60% { transform: translateY(10px) scale(0.95); }
    80% { transform: translateY(-10px) scale(1.05); }
    100% { transform: translateY(0) scale(1); }
  }
  .animate-bounce-short {
    animation: bounceShort 0.8s cubic-bezier(0.28, 0.84, 0.42, 1) forwards;
  }
</style>
