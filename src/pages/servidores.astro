---
import '../styles/global.css';
import { query } from '../lib/db';
import MetasReto from '../components/MetasReto';

let calendarData: any = { hero: {}, months: [] };
try {
    const res = await query("SELECT value FROM app_config WHERE key = 'calendar_itinerary'");
    if (res.rows.length > 0) {
        calendarData = res.rows[0].value;
    }
} catch (e) {
    console.error("Error loading calendar data", e);
}

let birthdays: any[] = [];
try {
    const bRes = await query("SELECT full_name, birthdate FROM servidores WHERE birthdate IS NOT NULL");
    birthdays = bRes.rows.map(r => {
        const d = new Date(r.birthdate);
        return {
            name: r.full_name,
            month: String(d.getUTCMonth() + 1).padStart(2, '0'),
            day: d.getUTCDate()
        };
    });
} catch (e) {
    console.error("Error loading birthdays", e);
}

// Calculate current date to highlight "Hoy" (Colombia Time)
const nowStr = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'America/Bogota',
    month: '2-digit',
    day: '2-digit',
    year: 'numeric'
}).format(new Date()); // Output format: "DD/MM/YYYY"
const [dayPart, monthPart, yearPart] = nowStr.split('/');
const currentMonthStr = monthPart;
const currentDayNum = parseInt(dayPart);
const currentYear = parseInt(yearPart);
// Only highlight if we are in 2026
const is2026 = currentYear === 2026;
---
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
<meta charset="UTF-8">
<title>Servidores | Bartimeo 2026</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Titan+One&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<!-- Import global CSS for tailwind utilities required by React -->
<link rel="stylesheet" href="/src/styles/global.css" />
<style>
  :root{
    /* Estilos Oficiales Bartimeo */
    --night: #1a0a0d;
    --night-2: #2d1117;
    --gold: #f8b134;
    --gold-soft: #ffcc66;
    --parchment: #640010;
    --wine: #4a000a;
    --wine-soft: #300006;
    --ink: #ffffff;
    --ink-soft: rgba(255,255,255,0.8);
    --line: rgba(255,255,255,0.15);
    
    /* Vivos */
    --brand-glow: rgba(248,177,52,0.6);
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
    /* Red gradient más vivo e iluminado con la imagen de fondo */
    background-image: radial-gradient(circle at top center, rgba(160, 20, 30, 0.7) 0%, rgba(80, 0, 15, 0.9) 70%), url('/bartimeo-bg.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
  }

  /* Nav Tabs */
  .servidores-nav {
    display: flex;
    justify-content: center;
    gap: 12px;
    padding: 24px;
    background: rgba(0,0,0,0.5);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(15px);
  }
  .nav-tab {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--ink-soft);
    padding: 10px 24px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .nav-tab.active {
    background: var(--gold);
    color: #000;
    border-color: var(--gold);
    box-shadow: 0 0 15px rgba(248,177,52,0.4);
  }
  .nav-tab:hover:not(.active) {
    background: rgba(255,255,255,0.1);
    color: var(--ink);
  }

  /* Views */
  .view-section {
    display: none;
    animation: fadeIn 0.4s ease;
  }
  .view-section.active {
    display: block;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Hero Calendar */
  .hero{
    padding: 64px 24px 48px;
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .hero-inner{ max-width: 980px; margin: 0 auto; position:relative; }
  .eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 14px;
  }
  h1{
    font-family: 'Titan One', cursive;
    font-weight: 400;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.1;
    margin: 0 0 14px;
    white-space: pre-line;
    color: var(--ink);
    text-shadow: 2px 4px 0px rgba(0,0,0,0.8), 0 0 20px rgba(248,177,52,0.4);
    letter-spacing: 1px;
  }
  .hero p{
    font-size: 18px;
    color: var(--ink-soft);
    max-width: 660px;
    line-height:1.55;
    margin: 0 auto 32px;
    text-shadow: 0 2px 4px rgba(0,0,0,0.8);
  }
  .journey-track{
    flex:1;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, #4a000a 0%, var(--gold) 100%);
    max-width: 620px;
    margin: 0 auto;
    box-shadow: 0 0 10px var(--brand-glow);
  }
  .journey-labels{
    display:flex;
    justify-content: space-between;
    max-width: 620px;
    margin: 10px auto 0;
    font-family:'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.9);
    text-transform: uppercase;
    text-shadow: 0 2px 4px rgba(0,0,0,0.8);
  }

  main{ width: 100%; max-width: 1200px; margin: 0 auto; padding: 32px 16px; }
  .month{ margin-bottom: 80px; }
  .month-head{
    display:flex;
    align-items:baseline;
    gap: 16px;
    margin-bottom: 24px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 12px;
  }
  .month-num{
    font-family: 'Titan One', cursive;
    font-size: 24px;
    color: var(--gold);
    text-shadow: 0 2px 4px rgba(0,0,0,0.8), 0 0 10px var(--brand-glow);
  }
  h2{
    font-family: 'Titan One', cursive;
    font-weight: 400;
    font-size: 42px;
    margin:0;
    color: var(--ink);
    text-shadow: 2px 4px 0px rgba(0,0,0,0.8), 0 0 15px rgba(255,255,255,0.2);
    letter-spacing: 1px;
  }

  /* Desktop Grid View */
  .desktop-grid {
    display: none;
  }
  @media (min-width: 768px) {
    .desktop-grid {
      display: grid;
      grid-template-columns: repeat(7, minmax(140px, 1fr));
      gap: 1px;
      background: rgba(255,255,255,0.15); /* Thin borders */
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 4px;
      overflow-x: auto; /* Prevents 7th column from being cut off on narrow screens */
      width: 100%;
    }
    .mobile-agenda {
      display: none;
    }
  }

  /* Grid styles */
  .dow{
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.8);
    text-align:center;
    padding: 12px 8px;
    font-weight: 600;
    background: rgba(0,0,0,0.4);
  }
  .cell{
    min-height: 160px;
    display:flex;
    flex-direction: column;
    padding: 6px;
    background: rgba(100, 0, 16, 0.4);
    backdrop-filter: blur(5px);
    transition: all 0.3s ease;
  }
  .cell:hover {
    background: rgba(140, 0, 20, 0.5);
  }
  .cell.empty{ 
    background: rgba(0,0,0,0.1); 
  }
  .cell-day{
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: rgba(255,255,255,0.8);
    margin-bottom: 8px;
    text-align: right;
    padding-right: 4px;
    display: flex;
    justify-content: space-between; /* Space out the emoji and the date number */
    align-items: center;
  }
  .cell.event .cell-day {
    color: #fff;
  }
  .cell.retreat {
    background: rgba(248,177,52,0.1);
  }
  .cell.retreat .cell-day {
    color: var(--gold);
  }

  /* Card events inside the cell (Desktop) */
  .event-pill {
    background: transparent;
    color: #fff;
    padding: 10px 8px;
    border-radius: 50%; /* Oval shape */
    font-family: 'Dancing Script', cursive;
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 8px;
    line-height: 1.1;
    border: 1.5px solid var(--gold);
    text-align: center;
    text-shadow: 0 2px 4px rgba(0,0,0,0.8);
    box-shadow: inset 0 0 10px rgba(0,0,0,0.2);
  }
  .event-pill.c-1 { border-color: #ff6b6b; color: #ffe3e3; }
  .event-pill.c-2 { border-color: #4ecdc4; color: #e0f9f8; }
  .event-pill.c-3 { border-color: #feca57; color: #fff3d6; }
  
  .event-pill.retreat {
    background: transparent;
    color: var(--gold);
    border: 2px solid var(--gold);
    border-radius: 4px;
    font-family: 'Fraunces', serif;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 14px 8px;
    box-shadow: inset 0 0 15px rgba(248,177,52,0.2);
  }

  /* Birthday styles */
  .bday-icon {
    font-size: 16px;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
  }
  /* Today Highlighting */
  @keyframes floatBadge {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, -5px); }
  }
  .cell.today {
    border: 2px solid var(--gold);
    box-shadow: 0 0 25px rgba(248,177,52,0.4), inset 0 0 20px rgba(248,177,52,0.1);
    position: relative;
    z-index: 10;
  }
  .cell.today::after {
    content: "¡HOY!";
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--gold);
    color: #000;
    font-family: 'Titan One', cursive;
    font-size: 12px;
    padding: 2px 12px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.5);
    animation: floatBadge 2s ease-in-out infinite;
    letter-spacing: 1px;
    z-index: 11;
  }

  /* Mobile Agenda View */
  .mobile-agenda {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .agenda-card {
    display: flex;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 16px;
    overflow: hidden;
    position: relative;
  }
  .agenda-card.today {
    border: 2px solid var(--gold);
    box-shadow: 0 0 25px rgba(248,177,52,0.3);
  }
  .agenda-card.today::before {
    content: "¡HOY!";
    position: absolute;
    top: 12px;
    right: -25px;
    background: var(--gold);
    color: #000;
    font-family: 'Titan One', cursive;
    font-size: 11px;
    padding: 2px 30px;
    transform: rotate(45deg);
    box-shadow: 0 2px 5px rgba(0,0,0,0.5);
    z-index: 10;
    letter-spacing: 1px;
  }
  .agenda-date {
    background: rgba(0,0,0,0.6);
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 85px;
    border-right: 1px solid rgba(255,255,255,0.1);
  }
  .agenda-date .day {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 32px;
    font-weight: 700;
    color: var(--gold);
    line-height: 1;
    text-shadow: 0 0 10px rgba(248,177,52,0.3);
  }
  .agenda-date .dow-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
    margin-top: 8px;
  }
  .agenda-content {
    padding: 20px 16px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    justify-content: center;
  }
  .agenda-card.retreat {
    border-color: rgba(248,177,52,0.4);
    background: rgba(248,177,52,0.1);
  }
  .agenda-card.retreat .agenda-date {
    background: rgba(248,177,52,0.2);
  }
  .agenda-event {
    font-family: 'Dancing Script', cursive;
    font-size: 24px;
    color: #fff;
    line-height: 1.2;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }
  .agenda-card.retreat .agenda-event {
    font-family: 'Fraunces', serif;
    font-size: 18px;
    text-transform: uppercase;
    color: var(--gold);
    letter-spacing: 1px;
  }
</style>
</head>
<body>

<nav class="servidores-nav">
  <button class="nav-tab active" data-target="calendario-view">Itinerario 2026</button>
  <button class="nav-tab" data-target="metas-view">Metas Reto</button>
  <a href="/servidores/ventas" class="nav-tab" style="text-decoration:none;">Ventas</a>
</nav>

<div id="calendario-view" class="view-section active">
  <div class="hero">
    <div class="hero-inner">
      <div class="eyebrow">{calendarData.hero?.eyebrow}</div>
      <h1>{calendarData.hero?.title}</h1>
      <p>{calendarData.hero?.description}</p>
    </div>
  </div>

  <main>
    {calendarData.months?.filter((m: any) => !m.hidden).map((month: any) => {
      // Calculate Monday-first empty days
      const originalEmpty = month.emptyDaysStart || 0;
      const mondayEmpty = (originalEmpty + 6) % 7;
      
      const emptyCells = Array.from({ length: mondayEmpty }, (_, i) => i);
      const dayCells = Array.from({ length: month.totalDays || 30 }, (_, i) => i + 1);
      
      const dowNames = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
      let colorIndex = 1;

      return (
        <section class="month">
          <div class="month-head">
            <span class="month-num">{month.id}</span>
            <h2>{month.name}</h2>
          </div>
          
          {/* Desktop Grid */}
          <div class="desktop-grid">
            {dowNames.map(d => <div class="dow">{d}</div>)}
            
            {emptyCells.map(() => <div class="cell empty"></div>)}
            
            {dayCells.map(day => {
              const isEvent = month.eventDays?.includes(day);
              const isRetreat = month.retreatDays?.includes(day);
              
              const isToday = is2026 && month.id === currentMonthStr && day === currentDayNum;
              
              const className = `cell ${isEvent ? 'event' : ''} ${isRetreat ? 'retreat' : ''} ${isToday ? 'today' : ''}`;
              
              const dayCards = month.cards?.filter((card: any) => {
                const matchDays = card.date.match(/\d+/g)?.map(Number) || [];
                return matchDays.includes(day);
              }) || [];

              const dayBirthdays = birthdays.filter(b => b.month === month.id && b.day === day);

              return (
                <div class={className}>
                  <div class="cell-day">
                    <div style="display:flex; gap:2px; flex-wrap:wrap;">
                      {dayBirthdays.map((b: any) => (
                        <span class="bday-icon" title={`Cumpleaños: ${b.name}`}>🥳</span>
                      ))}
                    </div>
                    <span>{day}</span>
                  </div>

                  {dayCards.map((card: any) => {
                    const publicFields = card.fields?.filter((f: any) => {
                      const lowerLabel = f.label.toLowerCase();
                      return !lowerLabel.includes('hora santa') && !lowerLabel.includes('catequesis');
                    });

                    return publicFields?.map((field: any) => {
                      const cClass = card.isRetreat || isRetreat ? 'retreat' : `c-${(colorIndex++ % 3) + 1}`;
                      return (
                        <div class={`event-pill ${cClass}`}>
                          {field.value}
                        </div>
                      )
                    });
                  })}
                </div>
              );
            })}
          </div>

          {/* Mobile Agenda */}
          <div class="mobile-agenda">
            {dayCells.map(day => {
              const isEvent = month.eventDays?.includes(day);
              const isRetreat = month.retreatDays?.includes(day);
              
              if (!isEvent && !isRetreat) return null;

              const dayCards = month.cards?.filter((card: any) => {
                const matchDays = card.date.match(/\d+/g)?.map(Number) || [];
                return matchDays.includes(day);
              }) || [];

              const dayBirthdays = birthdays.filter(b => b.month === month.id && b.day === day);

              if (dayCards.length === 0 && dayBirthdays.length === 0) return null;

              // Calculate DOW (Monday-first)
              const dowIndex = (mondayEmpty + day - 1) % 7;
              const dowName = dowNames[dowIndex];
              
              const isToday = is2026 && month.id === currentMonthStr && day === currentDayNum;

              return (
                <div class={`agenda-card ${isRetreat ? 'retreat' : ''} ${isToday ? 'today' : ''}`}>
                  <div class="agenda-date">
                    <span class="day">{day}</span>
                    <span class="dow-label">{dowName}</span>
                    <div style="display:flex; gap:2px; flex-wrap:wrap; justify-content:center; margin-top:4px;">
                      {dayBirthdays.map((b: any) => (
                        <span class="bday-icon" title={`Cumpleaños: ${b.name}`}>🥳</span>
                      ))}
                    </div>
                  </div>
                  <div class="agenda-content">
                    {dayCards.map((card: any) => {
                      const publicFields = card.fields?.filter((f: any) => {
                        const lowerLabel = f.label.toLowerCase();
                        return !lowerLabel.includes('hora santa') && !lowerLabel.includes('catequesis');
                      });

                      return publicFields?.map((field: any) => (
                        <div class="agenda-event">
                          {field.value}
                        </div>
                      ));
                    })}
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      );
    })}
  </main>
</div>

<div id="metas-view" class="view-section">
  <main class="w-full">
    <MetasReto client:load />
  </main>
</div>

<script is:inline>
  document.querySelectorAll('.nav-tab').forEach(tab => {
    tab.addEventListener('click', (e) => {
      document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.view-section').forEach(v => v.classList.remove('active'));
      
      e.target.classList.add('active');
      const targetId = e.target.getAttribute('data-target');
      document.getElementById(targetId).classList.add('active');
    });
  });
</script>

</body>
</html>
