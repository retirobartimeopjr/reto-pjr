---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/webp" href="/logo-rojo.webp" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO & Metatags -->
    <title>Retiro Bartimeo Colombia | {title}</title>
    <meta
      name="description"
      content="V Retiro Bartimeo en la Parroquia Jesucristo Redentor. Únete a nuestra Comunidad de Fe Católica y vive una experiencia transformadora en Colombia."
    />
    <meta
      name="keywords"
      content="Retiro Bartimeo, Bartimeo Colombia, Católico, Comunidad, Iglesia, Fe, Parroquia Jesucristo Redentor, V Retiro"
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://retirobartimeo.org/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://retirobartimeo.org/" />
    <meta property="og:title" content="Retiro Bartimeo Colombia | V Retiro" />
    <meta
      property="og:description"
      content="V Retiro Bartimeo en la Parroquia Jesucristo Redentor. Comunidad, Fe e Iglesia Católica en Colombia."
    />
    <meta property="og:image" content="https://retirobartimeo.org/bartimeo.png" />
    <meta property="og:site_name" content="Retiro Bartimeo Colombia" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Event",
        "name": "V Retiro Bartimeo",
        "startDate": "2026-03-20T17:00",
        "eventStatus": "https://schema.org/EventScheduled",
        "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
        "location": {
          "@type": "Place",
          "name": "Parroquia Jesucristo Redentor",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Colombia",
            "addressCountry": "CO"
          }
        },
        "description": "V Retiro Bartimeo en la Parroquia Jesucristo Redentor. Un evento Católico de Fe y Comunidad, organizado por la Iglesia.",
        "image": ["https://retirobartimeo.org/bartimeo.png"],
        "organizer": {
          "@type": "Organization",
          "name": "Parroquia Jesucristo Redentor",
          "url": "https://retirobartimeo.org"
        }
      }
    </script>

    <link
      rel="preload"
      href="/fonts/century.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/century-bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/heavy.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <ClientRouter />
  </head>
  <body class="bg-[#640010] text-white overflow-x-hidden">
    <!-- Persistent Background Music -->
    <audio id="bg-music" src="/song.mp3" preload="auto" transition:persist loop></audio>

    <slot />
  </body>
</html>

<style is:global>
  :root {
    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      rgb(var(--accent-light)) 30%,
      white 60%
    );
  }
  /* Ensure Leaflet CSS is loaded if needed globally, but component handles it */
  /* html { font-family: system-ui, sans-serif; } */
</style>
