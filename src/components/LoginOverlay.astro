---
interface Props {
  isLocked: boolean
  message?: string
}

const { isLocked, message = 'Unlock by logging in' } = Astro.props
---

<div class="relative w-full h-full group login-overlay-container">
  <div
    class:list={[
      'transition-all duration-500 login-blur-content',
      isLocked ? 'blur-md select-none pointer-events-none opacity-50' : '',
    ]}
  >
    <slot />
  </div>

  {
    isLocked && (
      <div class="absolute inset-0 z-20 flex flex-col items-center justify-center p-4 bg-black/40 backdrop-blur-[2px] rounded-xl border border-white/10 group-hover:bg-black/50 transition-colors login-overlay-layer">
        <div class="bg-black/60 p-6 rounded-2xl border border-white/20 shadow-2xl backdrop-blur-md flex flex-col items-center gap-3 max-w-sm text-center transform transition-transform duration-300 group-hover:scale-105">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-[#f8b134]"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
          <span class="text-white font-serif tracking-wider font-bold text-lg">{message}</span>
          <p class="text-white/60 text-xs uppercase tracking-widest mt-1">Contenido restringido</p>
        </div>
      </div>
    )
  }
</div>
