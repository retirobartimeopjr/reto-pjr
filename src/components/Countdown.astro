---

---

<div id="countdown-timer" class="w-full my-4">
  <div class="flex flex-col items-center gap-2">
    <h3
      class="text-[#f8b134] uppercase tracking-widest text-sm font-black text-center mb-2 drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]"
    >
      Contador para el fin de la competencia y comienzo de nuestro IV Retiro!!
    </h3>

    <div
      class="flex flex-wrap justify-center gap-1 sm:gap-2 md:gap-3 text-center w-full max-w-[300px]"
    >
      <!-- Days -->
      <div class="flex flex-col items-center gap-1">
        <div
          class="relative w-10 h-12 sm:w-12 sm:h-14 md:w-14 md:h-16 bg-black/30 border border-white/10 rounded-md flex items-center justify-center backdrop-blur-sm"
        >
          <span id="days" class="text-lg sm:text-xl md:text-2xl font-black text-[#f8b134] font-mono"
            >00</span
          >
        </div>
        <span class="text-[8px] text-white/50 uppercase tracking-wider">Días</span>
      </div>

      <div class="flex items-center text-white/20 text-lg -mt-4">:</div>

      <!-- Hours -->
      <div class="flex flex-col items-center gap-1">
        <div
          class="relative w-10 h-12 sm:w-12 sm:h-14 md:w-14 md:h-16 bg-black/30 border border-white/10 rounded-md flex items-center justify-center backdrop-blur-sm"
        >
          <span
            id="hours"
            class="text-lg sm:text-xl md:text-2xl font-black text-[#f8b134] font-mono">00</span
          >
        </div>
        <span class="text-[8px] text-white/50 uppercase tracking-wider">Hrs</span>
      </div>

      <div class="flex items-center text-white/20 text-lg -mt-4">:</div>

      <!-- Minutes -->
      <div class="flex flex-col items-center gap-1">
        <div
          class="relative w-10 h-12 sm:w-12 sm:h-14 md:w-14 md:h-16 bg-black/30 border border-white/10 rounded-md flex items-center justify-center backdrop-blur-sm"
        >
          <span
            id="minutes"
            class="text-lg sm:text-xl md:text-2xl font-black text-[#f8b134] font-mono">00</span
          >
        </div>
        <span class="text-[8px] text-white/50 uppercase tracking-wider">Min</span>
      </div>

      <div class="flex items-center text-white/20 text-lg -mt-4">:</div>

      <!-- Seconds -->
      <div class="flex flex-col items-center gap-1">
        <div
          class="relative w-10 h-12 sm:w-12 sm:h-14 md:w-14 md:h-16 bg-black/30 border border-white/10 rounded-md flex items-center justify-center backdrop-blur-sm"
        >
          <span
            id="seconds"
            class="text-lg sm:text-xl md:text-2xl font-black text-[#f8b134] font-mono">00</span
          >
        </div>
        <span class="text-[8px] text-white/50 uppercase tracking-wider">Seg</span>
      </div>
    </div>
  </div>
</div>

<script>
  function updateCountdown() {
    // March 20, 2026 5:00 PM (17:00)
    // Assuming user wants next occurrence or specifically 2026?
    // Context says "2026 Project", so 2026.
    // Fixed Date: 2026-03-20T17:00:00

    const targetDate = new Date('2026-03-20T17:00:00').getTime()

    const interval = setInterval(() => {
      const now = new Date().getTime()
      const distance = targetDate - now

      if (distance < 0) {
        clearInterval(interval)
        document.getElementById('countdown-timer').innerHTML =
          "<div class='text-center text-xl text-[#f8b134] font-bold'>¡El tiempo ha llegado!</div>"
        return
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24))
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60))
      const seconds = Math.floor((distance % (1000 * 60)) / 1000)

      const elDays = document.getElementById('days')
      const elHours = document.getElementById('hours')
      const elMinutes = document.getElementById('minutes')
      const elSeconds = document.getElementById('seconds')

      if (elDays) elDays.innerText = days.toString().padStart(2, '0')
      if (elHours) elHours.innerText = hours.toString().padStart(2, '0')
      if (elMinutes) elMinutes.innerText = minutes.toString().padStart(2, '0')
      if (elSeconds) elSeconds.innerText = seconds.toString().padStart(2, '0')
    }, 1000)
  }

  updateCountdown()
  document.addEventListener('astro:page-load', updateCountdown)
</script>
