<section class="w-full mt-10 mb-6">
  <div class="flex flex-col items-center gap-4">
    <h3 class="text-white/60 uppercase tracking-[0.3em] text-xs font-bold">Tiempo restante</h3>

    <div class="flex gap-4 md:gap-8 text-center">
      <div class="flex flex-col items-center gap-1">
        <div
          class="relative w-16 h-20 md:w-20 md:h-24 bg-black/30 border border-white/10 rounded-lg flex items-center justify-center backdrop-blur-sm"
        >
          <span class="text-3xl md:text-4xl font-black text-[#f8b134] font-mono">04</span>
        </div>
        <span class="text-[10px] text-white/50 uppercase tracking-wider">Días</span>
      </div>

      <div class="flex items-center text-white/20 text-2xl -mt-6">:</div>

      <div class="flex flex-col items-center gap-1">
        <div
          class="relative w-16 h-20 md:w-20 md:h-24 bg-black/30 border border-white/10 rounded-lg flex items-center justify-center backdrop-blur-sm"
        >
          <span class="text-3xl md:text-4xl font-black text-[#f8b134] font-mono">12</span>
        </div>
        <span class="text-[10px] text-white/50 uppercase tracking-wider">Hrs</span>
      </div>

      <div class="flex items-center text-white/20 text-2xl -mt-6">:</div>

      <div class="flex flex-col items-center gap-1">
        <div
          class="relative w-16 h-20 md:w-20 md:h-24 bg-black/30 border border-white/10 rounded-lg flex items-center justify-center backdrop-blur-sm"
        >
          <span class="text-3xl md:text-4xl font-black text-[#f8b134] font-mono">35</span>
        </div>
        <span class="text-[10px] text-white/50 uppercase tracking-wider">Min</span>
      </div>
    </div>
  </div>
</section>
