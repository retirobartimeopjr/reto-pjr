---
import LoginModule from '../LoginModule'
import MusicControl from '../MusicControl'
---

<header
  class="absolute top-0 left-0 w-full z-50 px-6 py-4 flex justify-between items-center pointer-events-none"
>
  <!-- Left Side: Music Control - enable pointer events -->
  <div class="flex items-center gap-2 pointer-events-auto">
    <MusicControl client:load />

    {/* Parroquia Logo Button */}
    <a
      href="https://jesucristoredentor.com/"
      target="_blank"
      rel="noopener noreferrer"
      class="group relative flex items-center justify-center p-2 w-12 h-12 bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 rounded-full transition-all duration-300 hover:scale-110 active:scale-95 cursor-pointer overflow-hidden z-50 ml-2"
      aria-label="Sitio web Parroquia Jesucristo Redentor"
    >
      <img
        src="/logoParroquia.webp"
        alt="Logo Parroquia Jesucristo Redentor"
        class="w-full h-full object-contain drop-shadow-md group-hover:drop-shadow-glow transition-all"
      />
    </a>
  </div>

  <!-- Right Side: Login - enable pointer events -->
  <div class="pointer-events-auto">
    <LoginModule client:load />
  </div>
</header>
