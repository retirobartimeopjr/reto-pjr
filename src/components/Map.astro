---
import BentoCard from '@/components/ui/BentoCard.astro'

const DEFAULT_LATITUDE = '4.60971' // Bogota
const DEFAULT_LONGITUDE = '-74.08175'

// Leer la request de Astro y recuperar los headers x-vercel-ip-latitude y x-vercel-ip-longitude
const ipLatitude = Astro.request.headers.get('cf-iplatitude') ?? DEFAULT_LATITUDE
const ipLongitude = Astro.request.headers.get('cf-iplongitude') ?? DEFAULT_LONGITUDE

// Determinar el centro del mapa
let centerLat: number
let centerLon: number
let initialZoom: number

if (ipLatitude && ipLongitude && Astro.request.headers.get('cf-iplatitude')) {
  // Usar la ubicación del usuario basada en IP si está disponible
  centerLat = parseFloat(ipLatitude)
  centerLon = parseFloat(ipLongitude)
  initialZoom = 13
} else {
  // Fallback: Bogota
  centerLat = 4.60971
  centerLon = -74.08175
  initialZoom = 12
}

// Indicar si tenemos ubicación del usuario
const hasUserLocation = !!Astro.request.headers.get('cf-iplatitude')
---

<BentoCard class="col-span-3 md:col-span-3 p-4 md:p-8 h-full" style="animation-delay: 0.2s;">
  <div id="tiendas" class="mb-4 text-center">
    <p
      class="text-white text-lg md:text-xl font-medium max-w-2xl mx-auto leading-relaxed drop-shadow-md"
    >
      Cuando visites una de las parroquias del mapa, <span
        class="text-[#f8b134] font-bold underline decoration-2 underline-offset-4"
        >¡confirma tu Visita para ganar puntos!</span
      >
    </p>
  </div>

  <section class="space-y-4 h-full" aria-labelledby="map-title">
    <h2 id="map-title" class="sr-only">Mapa de Parroquias</h2>

    <div
      id="map"
      class="w-full h-[500px] md:h-[600px] rounded-lg shadow-lg border-2 border-[#f8b134]/30 relative"
      role="application"
      aria-label="Mapa interactivo mostrando ubicaciones"
      data-has-user-location={hasUserLocation ? 'true' : 'false'}
      data-center-lat={centerLat}
      data-center-lon={centerLon}
      data-initial-zoom={initialZoom}
    >
      {/* Search Input Custom Control */}
      <div
        class="absolute top-4 left-14 right-4 md:left-16 md:right-auto md:w-80 z-[1000] font-sans"
      >
        <div class="relative group">
          <input
            id="parish-search"
            type="text"
            placeholder="Buscar parroquia..."
            class="w-full bg-white/90 backdrop-blur-md rounded-full py-3 pl-10 pr-4 shadow-lg border border-gray-200 outline-none focus:ring-2 focus:ring-[#f8b134] text-gray-700 placeholder-gray-400 transition-all text-sm font-semibold"
          />
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          {/* Autocomplete Dropdown */}
          <div
            id="search-results"
            class="hidden absolute top-full left-0 right-0 mt-2 bg-white rounded-xl shadow-xl overflow-hidden max-h-60 overflow-y-auto border border-gray-100 divide-y divide-gray-100"
          >
            {/* Results injected by JS */}
          </div>
        </div>
      </div>

      {/* Botones de Control de Ubicación */}
      <div class="absolute bottom-6 right-6 z-[1000] flex flex-col gap-2">
        <button
          id="btn-location"
          class="bg-white text-gray-800 p-3 rounded-full shadow-lg hover:bg-gray-100 transition-all transform active:scale-95 focus:outline-none focus:ring-2 focus:ring-[#f8b134]"
          title="Centrar en mi ubicación"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </button>
        <button
          id="btn-refresh"
          class="bg-white text-gray-800 p-3 rounded-full shadow-lg hover:bg-gray-100 transition-all transform active:scale-95 focus:outline-none focus:ring-2 focus:ring-[#f8b134]"
          title="Actualizar ubicación"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
            ></path>
          </svg>
        </button>
      </div>

      {/* Floating Proximity Button Overlay (Below Search) */}
      <div
        id="floating-confirm-btn"
        class="hidden absolute top-20 left-14 z-[500] animate-bounce-in"
      >
        <button
          class="flex items-center gap-3 px-4 py-2 bg-yellow-400/90 backdrop-blur-md rounded-full shadow-xl hover:scale-105 transition-transform border border-yellow-600/30"
        >
          <span class="animate-pulse w-2 h-2 rounded-full bg-red-600"></span>
          <div class="flex flex-col text-left">
            <span class="text-xs font-bold text-yellow-900 uppercase tracking-wider"
              >Estás en una parroquia</span
            >
            <span class="text-[#640010] font-bold text-sm leading-tight" id="floating-parish-name"
              >Parroquia</span
            >
          </div>
        </button>
      </div>

      {/* Distance Warning Modal */}
      <div
        id="distance-modal"
        class="hidden absolute inset-0 z-[2000] flex items-center justify-center bg-black/60 backdrop-blur-sm p-4"
      >
        <div
          class="bg-white rounded-2xl p-6 shadow-2xl max-w-sm w-full animate-bounce-in text-center"
        >
          <div
            class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8 text-gray-500"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Estás un poco lejos...</h3>
          <p class="text-gray-600 mb-6">
            Para confirmar tu visita debes estar en la parroquia. Actualmente estás a <strong
              id="distance-value"
              class="text-[#640010]">0m</strong
            > de distancia.
          </p>
          <button
            id="btn-close-distance"
            class="w-full bg-gray-200 text-gray-800 font-bold py-3 rounded-xl hover:bg-gray-300 transition-colors"
          >
            Entendido
          </button>
        </div>
      </div>

      {/* Confirmation Modal */}
      <div
        id="proximity-modal"
        class="hidden absolute inset-0 z-[2000] flex items-center justify-center bg-black/50 backdrop-blur-sm p-4"
      >
        <div
          class="bg-white rounded-2xl p-4 md:p-6 shadow-2xl max-w-sm w-full max-h-[90vh] flex flex-col animate-bounce-in text-center overflow-hidden"
        >
          <div
            class="shrink-0 w-12 h-12 md:w-16 md:h-16 bg-[#f8b134]/20 rounded-full flex items-center justify-center mx-auto mb-2 md:mb-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 md:h-8 md:w-8 text-[#d9901c]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="shrink-0 text-lg md:text-xl font-bold text-gray-900 mb-1 md:mb-2">
            ¡Has llegado!
          </h3>
          <p class="shrink-0 text-sm md:text-base text-gray-600 mb-2 md:mb-4">
            Estás cerca de <strong id="modal-parish-name" class="text-[#640010]"
              >nombre parroquia</strong
            >. ¿Confirmas visita?
          </p>
          <div
            class="mb-2 md:mb-4 text-left p-2 md:p-3 bg-gray-50 rounded-xl border border-gray-100 overflow-y-auto custom-scrollbar"
          >
            <p class="text-xs md:text-sm text-gray-700 mb-2 md:mb-3 font-medium leading-relaxed">
              Por motivos de seguridad y verificar que estás realizando el reto, sube una foto tuya
              con la parroquia de fondo.
            </p>

            <label
              for="photo-upload-input"
              class="flex flex-col items-center justify-center gap-1 w-full bg-gradient-to-r from-[#f8b134]/10 to-[#f8b134]/5 hover:from-[#f8b134]/20 hover:to-[#f8b134]/10 text-[#d9901c] font-bold py-3 md:py-4 px-2 rounded-xl cursor-pointer transition-all border-2 border-dashed border-[#f8b134]/40 hover:border-[#f8b134] text-center group shadow-sm hover:shadow-md"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8 md:h-10 md:w-10 mb-1 md:mb-2 text-[#f8b134] group-hover:scale-110 transition-transform duration-300"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span class="text-sm md:text-lg tracking-tight">📸 Subir Evidencia</span>
              <span class="text-[9px] md:text-xs font-normal text-gray-500 mt-0"
                >(Toca aquí para subir foto)</span
              >
            </label>
            <input
              type="file"
              id="photo-upload-input"
              accept="image/*"
              capture="environment"
              class="hidden"
            />

            <div
              id="file-selected-name"
              class="hidden mt-2 md:mt-4 text-[11px] md:text-sm text-center text-green-700 font-bold overflow-hidden text-ellipsis whitespace-nowrap bg-green-50 p-2 md:p-3 rounded-lg border border-green-200 shadow-inner flex items-center justify-center gap-1 md:gap-2"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 md:h-5 md:w-5"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span id="file-selected-text">Evidencia seleccionada</span>
            </div>

            <div
              id="upload-status"
              class="hidden mt-2 md:mt-4 text-xs md:text-sm font-bold text-center text-[#d9901c] bg-[#f8b134]/10 p-2 md:p-3 rounded-lg border border-[#f8b134]/20 animate-pulse"
            >
              Subiendo foto... <span id="upload-progress">0%</span>
            </div>
          </div>
          <div
            class="shrink-0 flex gap-2 md:gap-3 justify-center mt-2 pt-2 border-t border-gray-100"
          >
            <button
              id="btn-cancel-arrival"
              class="px-4 md:px-5 py-2 md:py-2.5 text-sm md:text-base rounded-xl border border-gray-300 text-gray-600 font-semibold hover:bg-gray-50 transition-colors"
            >
              Cancelar
            </button>
            <button
              id="btn-confirm-arrival"
              class="px-4 md:px-5 py-2 md:py-2.5 text-sm md:text-base rounded-xl bg-gradient-to-r from-[#f8b134] to-[#eeb045] text-[#640010] font-bold shadow-lg hover:shadow-xl hover:scale-105 transition-all"
            >
              ¡Sí, estoy aquí!
            </button>
          </div>
        </div>
      </div>

      {/* Success Animation Overlay */}
      <div
        id="success-overlay"
        class="hidden absolute inset-0 z-[2001] flex items-center justify-center bg-[#640010]/90 backdrop-blur-md"
      >
        <div class="text-center animate-scale-up">
          <div class="relative w-32 h-32 mx-auto mb-6">
            <div class="absolute inset-0 bg-[#f8b134] rounded-full animate-ping opacity-20"></div>
            <div
              class="relative w-32 h-32 bg-[#f8b134] rounded-full flex items-center justify-center shadow-[0_0_40px_rgba(248,177,52,0.6)]"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-16 w-16 text-[#640010]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="3"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
          </div>
          <h2 class="text-3xl font-bold text-white mb-2 tracking-wide">¡Visita Confirmada!</h2>
          <p class="text-white/80 text-lg">Tu fe te ha traído hasta aquí.</p>
          <button
            id="btn-close-success"
            class="mt-8 text-sm text-white/60 hover:text-white underline decoration-dashed"
            >Volver al mapa</button
          >
        </div>
      </div>
      {/* Login Required Modal */}
      <div
        id="login-required-modal"
        class="hidden absolute inset-0 z-[2002] flex items-center justify-center bg-black/80 backdrop-blur-md p-4"
      >
        <div
          class="bg-[#1a1a1a] border border-white/10 rounded-2xl p-6 shadow-2xl max-w-sm w-full animate-bounce-in text-center relative overflow-hidden"
        >
          {/* Decorative gradient */}
          <div
            class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-[#f8b134] to-[#bf8418]"
          >
          </div>

          <div
            class="w-16 h-16 bg-[#f8b134]/10 rounded-full flex items-center justify-center mx-auto mb-4 border border-[#f8b134]/20"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8 text-[#f8b134]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
              ></path>
            </svg>
          </div>

          <h3 class="text-xl font-bold text-white mb-2">Inicia Sesión</h3>
          <p class="text-white/60 mb-6 text-sm">
            Para confirmar tu visita y registrar tu progreso en el ranking, necesitas ingresar a tu
            cuenta.
          </p>

          <div class="flex flex-col gap-3">
            <button
              id="btn-trigger-login"
              class="w-full bg-gradient-to-r from-[#f8b134] to-[#bf8418] hover:from-[#fbd07e] hover:to-[#dca336] text-black font-bold py-3 rounded-xl shadow-lg transition-all active:scale-95"
            >
              Ingresar Ahora
            </button>
            <button
              id="btn-cancel-login"
              class="w-full bg-white/5 text-white/50 font-medium py-3 rounded-xl hover:bg-white/10 hover:text-white transition-colors"
            >
              Cancelar
            </button>
          </div>
        </div>
      </div>
      {/* Already Visited Modal */}
      <div
        id="already-visited-modal"
        class="hidden absolute inset-0 z-[2002] flex items-center justify-center bg-black/80 backdrop-blur-sm p-4"
      >
        <div
          class="bg-white rounded-2xl p-6 shadow-2xl max-w-sm w-full animate-bounce-in text-center"
        >
          <div
            class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8 text-blue-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">¡Ya visitaste esta parroquia!</h3>
          <p class="text-gray-600 mb-6">
            Tu fe ya ha dejado huella aquí. Te invitamos a seguir peregrinando y visitar todas las
            demás parroquias del mapa para ganar más puntos.
          </p>
          <button
            id="btn-close-visited"
            class="w-full bg-blue-600 text-white font-bold py-3 rounded-xl hover:bg-blue-700 transition-colors shadow-lg"
          >
            Seguir Peregrinación
          </button>
        </div>
      </div>
    </div>

    <!-- Points Awarded Notification (Map Overlay) -->
    <div
      id="points-notification"
      class="absolute inset-0 z-[10000] flex items-center justify-center pointer-events-none hidden bg-black/60 backdrop-blur-sm rounded-lg"
    >
      <div
        class="transform scale-0 transition-transform duration-500 ease-out data-[show=true]:scale-100 flex flex-col items-center gap-2"
        id="points-container"
      >
        <h2
          class="text-3xl md:text-4xl font-serif text-[#f8b134] font-bold text-center animate-bounce drop-shadow-[0_4px_4px_rgba(0,0,0,0.5)]"
        >
          ¡Excelente!
        </h2>
        <p
          id="points-amount"
          class="text-6xl md:text-7xl font-black text-transparent bg-clip-text bg-gradient-to-b from-white to-gray-200 drop-shadow-[0_0_15px_rgba(248,177,52,0.8)]"
          style="-webkit-text-stroke: 1px #f8b134;"
        >
          +200
        </p>
        <p
          class="text-[#f8b134] text-lg md:text-xl font-bold uppercase tracking-[0.1em] mt-2 animate-pulse"
        >
          Puntos Ganados
        </p>
      </div>
    </div>
  </section>
</BentoCard>

<!-- Leyenda de colores -->
<aside class="legend-container p-4" aria-label="Leyenda de Vicarias">
  <h3 class="sr-only">Leyenda de Vicarias</h3>
  <ul class="flex flex-wrap gap-3 justify-center" id="legend" role="list">
    <!-- Leyenda items will be dynamic or static? Let's make a few static for now based on known vicarias -->
    <li
      class="group relative flex items-center gap-3 px-4 py-2 bg-black/40 border border-white/10 rounded-xl text-white text-sm font-bold shadow-sm"
    >
      <span class="w-3 h-3 rounded-full bg-orange-500 shadow-[0_0_10px_rgba(249,115,22,0.5)]"
      ></span> San Pedro
    </li>
    <li
      class="group relative flex items-center gap-3 px-4 py-2 bg-black/40 border border-white/10 rounded-xl text-white text-sm font-bold shadow-sm"
    >
      <span class="w-3 h-3 rounded-full bg-blue-600 shadow-[0_0_10px_rgba(37,99,235,0.5)]"></span> Misericordioso
    </li>
    <li
      class="group relative flex items-center gap-3 px-4 py-2 bg-black/40 border border-white/10 rounded-xl text-white text-sm font-bold shadow-sm"
    >
      <span class="w-3 h-3 rounded-full bg-green-500 shadow-[0_0_10px_rgba(16, 185, 129, 1)]"
      ></span> Otros Templos
    </li>
  </ul>
</aside>

<!-- Lista de Parroquias Cercanas -->
<section
  id="nearby-section"
  class="mt-6 hidden bg-black/20 backdrop-blur-sm rounded-xl border border-white/10 overflow-hidden transition-all duration-300"
>
  <button
    id="nearby-header"
    class="w-full flex items-center justify-between p-6 text-left focus:outline-none group hover:bg-white/5 transition-colors"
  >
    <div class="flex items-center gap-2">
      <span class="bg-[#f8b134] text-[#640010] p-1 rounded-lg">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
      </span>
      <h3 class="text-xl font-bold text-white group-hover:text-[#f8b134] transition-colors">
        Parroquias Más Cercanas
      </h3>
    </div>
    <svg
      id="nearby-chevron"
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6 text-white/50 transition-transform duration-300 group-hover:text-white"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </button>

  <div
    id="nearby-list"
    class="grid grid-cols-1 md:grid-cols-2 gap-4 p-6 pt-0 hidden animate-in slide-in-from-top-2"
  >
    <!-- Items injected here by JS -->
    <p class="text-white/50 italic col-span-full text-center py-4">Calculando ubicación...</p>
  </div>
</section>

<!-- Leaflet CSS -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<!-- Leaflet MarkerCluster CSS -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css"
  crossorigin=""
/>
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css"
  crossorigin=""
/>

<!-- Leaflet JS -->
<script
  is:inline
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""></script>

<!-- Leaflet MarkerCluster JS -->
<script
  is:inline
  src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"
  crossorigin=""></script>

<script>
  import confetti from 'canvas-confetti'
  import { getDownloadURL, ref, uploadBytesResumable } from 'firebase/storage'
  import { storage } from '../lib/firebase.client'
  import { isLoginOpen } from '../store/uiStore'

  // @ts-nocheck
  const L = window.L

  // Variables globales
  let $mapElement = null
  let mapInstance = null
  let userMarker = null
  let nearbySection = null

  // Data
  let centerLat, centerLon, initialZoom, hasUserLocation
  let locations = []
  let userCoords = { lat: null, lon: null }
  let watchId = null

  // Constants
  const NEARBY_RADIUS_KM = 2
  const PROXIMITY_THRESHOLD_M = 35
  let lastProximityCheck = 0 // timestamp
  let confirmedParishes = new Set() // Prevent multi-trigger

  // State for UX Refinements
  let hasShownInitialModal = false
  let isPopupOpen = false
  let currentProximityLoc = null // Holds the location object if in range

  const colors = {
    'san pedro': '#f97316',
    'padre misericordioso': '#2563eb',
    default: '#10b981',
  }

  // Init logic handlers
  document.addEventListener('astro:page-load', () => {
    initPage()
  })

  function initPage() {
    $mapElement = document.querySelector('#map')
    nearbySection = document.querySelector('#nearby-section')

    if ($mapElement) {
      // Limpieza crucial para Astro View Transitions
      // Si ya existía un mapa (ej. fuimos a otra página y volvimos), lo destruimos antes de recrearlo en el nuevo nodo DOM.
      if (mapInstance) {
        mapInstance.remove()
        mapInstance = null
      }
      window.mapInitialized = false

      if (!window.mapInitialized) {
        window.mapInitialized = true // Prevent double init

        centerLat = parseFloat($mapElement.dataset.centerLat)
        centerLon = parseFloat($mapElement.dataset.centerLon)
        initialZoom = parseInt($mapElement.dataset.initialZoom)
        hasUserLocation = $mapElement.dataset.hasUserLocation === 'true'

        initMap()
        setupUIControls()
      }
    }
  }

  async function initMap() {
    // 1. Fetch Data
    if (locations.length === 0) {
      try {
        const response = await fetch('/api/parroquias')
        locations = await response.json()
      } catch (e) {
        console.error('Error fetching locations', e)
        return
      }
    }

    // 2. Initialize Map
    mapInstance = L.map('map').setView([centerLat, centerLon], initialZoom)
    mapInstance.attributionControl.setPrefix('')

    // Popup Event Listeners for UX
    mapInstance.on('popupopen', () => {
      isPopupOpen = true
      updateFloatingButton()
    })
    mapInstance.on('popupclose', () => {
      isPopupOpen = false
      updateFloatingButton()
    })

    // 3. Tile Layer
    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; OpenStreetMap &copy; CARTO',
      maxZoom: 20,
    }).addTo(mapInstance)

    // 4. Markers
    renderMarkersWithClustering()

    // 5. Setup Interaction for Location (Permissions)
    setupMapInteractions()

    // 6. Populate nearby list with default/IP location initially
    updateNearbyList(centerLat, centerLon)
  }

  // ... (renderMarkersWithClustering remains same) ...

  function renderMarkersWithClustering() {
    // Crear el cluster group
    const markersCluster = L.markerClusterGroup({
      showCoverageOnHover: true,
      zoomToBoundsOnClick: true,
      spiderfyOnMaxZoom: true,
      removeOutsideVisibleBounds: true,
      animate: true,
      maxClusterRadius: 60,
      iconCreateFunction: function (cluster) {
        const childCount = cluster.getChildCount()
        let size = childCount < 10 ? 'small' : childCount < 50 ? 'medium' : 'large'
        const sizeMap = {
          small: { width: 50, height: 50, fontSize: '14px' },
          medium: { width: 60, height: 60, fontSize: '16px' },
          large: { width: 70, height: 70, fontSize: '18px' },
        }
        const dim = sizeMap[size]
        return L.divIcon({
          html: `<div class="cluster-icon cluster-${size}" style="width:${dim.width}px;height:${dim.height}px;">
                    <div class="cluster-inner"><span style="font-size:${dim.fontSize};font-weight:bold;">${childCount}</span></div>
                   </div>`,
          className: 'marker-cluster-custom',
          iconSize: L.point(dim.width, dim.height),
        })
      },
    })

    locations.forEach((loc) => {
      const lat = loc.center?.lat || loc.lat
      const lon = loc.center?.lng || loc.lng
      if (!lat || !lon) return

      const color = getColorForVicaria(loc.vicaria)

      // Custom Marker Icon
      const svgIcon = `
            <div class="marker-container relative w-[45px] h-[55px]">
              <div class="absolute -bottom-0.5 left-1/2 -translate-x-1/2 w-[30px] h-2 bg-[radial-gradient(ellipse,rgba(0,0,0,0.3)_0%,transparent_70%)]"></div>
              <div class="absolute inset-0 rounded-lg overflow-hidden flex items-center justify-center shadow-lg" style="background-color: ${color}; border: 2px solid white;">
                 <img src="/parroquia.png" alt="Parroquia" class="w-8 h-8 object-contain filter drop-shadow-sm" />
              </div>
              <div class="absolute top-0 left-0 right-0 h-[40%] bg-gradient-to-b from-white/30 to-transparent rounded-t-lg pointer-events-none"></div>
            </div>
          `
      const customIcon = L.divIcon({
        html: svgIcon,
        iconSize: [45, 55],
        iconAnchor: [22.5, 55],
        popupAnchor: [0, -55],
        className: 'custom-marker',
      })

      const marker = L.marker([lat, lon], { icon: customIcon })
      marker.bindPopup(
        `
            <div class="font-sans min-w-[200px] text-center">
              <div class="p-2">
                 <span class="text-xs font-bold text-gray-500 uppercase tracking-widest">${loc.vicaria || 'Vicaria'}</span>
                 <h3 class="text-lg font-bold text-gray-900 mt-1 mb-2">${loc.name}</h3>
                 
                 <div class="flex flex-col gap-2 mt-3">
                   <button 
                      onclick="window.validateAndConfirm('${loc.id || loc.name}', '${loc.name}')"
                      class="w-full bg-gradient-to-r from-[#f8b134] to-[#eeb045] text-[#640010] font-bold py-2 px-4 rounded-lg text-sm hover:shadow-md transition-all active:scale-95"
                   >
                      📍 Confirmar Visita
                   </button>
                   
                   <a 
                      href="https://www.google.com/maps/dir/?api=1&destination=${lat},${lon}"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-full block bg-gray-100 text-gray-600 font-semibold py-2 px-4 rounded-lg text-sm hover:bg-gray-200 transition-colors"
                   >
                      🚗 Cómo Llegar
                   </a>
                 </div>
              </div>
            </div>
          `,
        { className: 'custom-popup' }
      )

      markersCluster.addLayer(marker)
    })

    mapInstance.addLayer(markersCluster)
  }

  function startLocationTracking() {
    if ('geolocation' in navigator) {
      if (!watchId) {
        watchId = navigator.geolocation.watchPosition(
          (pos) => {
            updateUserLocation(pos.coords.latitude, pos.coords.longitude)
          },
          (err) => {
            console.warn('Geolocation error:', err)
            watchId = null // Reset to allow retry
          },
          { enableHighAccuracy: true, timeout: 5000, maximumAge: 0 }
        )
      } else {
        // Manual single fetch for "Refresh"
        navigator.geolocation.getCurrentPosition(
          (pos) => updateUserLocation(pos.coords.latitude, pos.coords.longitude),
          (err) => alert('No se pudo obtener tu ubicación. Verifica permisos y GPS.')
        )
      }
    } else {
      console.log('Navegador no soporta geolocalización')
    }
  }

  function updateUserLocation(lat, lon) {
    userCoords = { lat, lon }

    // 1. Update Map Marker
    if (!userMarker) {
      const userIcon = L.divIcon({
        html: `<svg width="24" height="24" viewBox="0 0 24 24" class="drop-shadow-md">
                  <circle cx="12" cy="12" r="10" fill="#f8b134" stroke="#fff" stroke-width="2"/>
                  <circle cx="12" cy="12" r="4" fill="#fff"/>
                 </svg>`,
        iconSize: [24, 24],
        iconAnchor: [12, 12],
        className: 'user-location-marker',
      })
      userMarker = L.marker([lat, lon], { icon: userIcon, zIndexOffset: 1000 }).addTo(mapInstance)
      // Initial FlyTo only once or on explicit demand?
      // Let's do it if it's the very first fix and user has allow it implicitly by using the app
      if (!hasUserLocation) {
        mapInstance.flyTo([lat, lon], 15)
        hasUserLocation = true
      }
    } else {
      userMarker.setLatLng([lat, lon])
    }

    // 2. Update Nearby List
    updateNearbyList(lat, lon)

    // 3. Check Proximity
    checkProximity(lat, lon)
  }

  function updateNearbyList(lat, lon) {
    if (!nearbySection) return

    const nearbyList = document.getElementById('nearby-list')
    const nearby = locations
      .map((loc) => {
        const d = calculateDistance(
          lat,
          lon,
          loc.center?.lat || loc.lat,
          loc.center?.lng || loc.lng
        )
        return { ...loc, distance: d }
      })
      .sort((a, b) => a.distance - b.distance)
      .slice(0, 5) // Mostrar siempre las 5 más cercanas

    if (nearby.length > 0) {
      nearbySection.classList.remove('hidden')
      nearbyList.innerHTML = nearby
        .map(
          (loc) => `
            <div class="bg-white/5 border border-white/5 hover:bg-white/10 transition-colors p-3 rounded-lg flex items-center justify-between group cursor-pointer" onclick="window.flyToParish(${loc.center?.lat || loc.lat}, ${loc.center?.lng || loc.lng})">
               <div>
                  <h4 class="font-bold text-white text-sm group-hover:text-[#f8b134] transition-colors">${loc.name}</h4>
                  <p class="text-[10px] text-white/50 uppercase tracking-wider">${loc.vicaria || 'Parroquia'}</p>
               </div>
               <div class="text-right">
                  <span class="block text-xs font-mono font-bold text-[#f8b134]">${loc.distance.toFixed(1)} km</span>
                  <span class="text-[10px] text-white/30">ver en mapa</span>
               </div>
            </div>
          `
        )
        .join('')
    } else {
      nearbySection.classList.add('hidden')
    }
  }

  // Make helper global for onclick
  window.flyToParish = (lat, lon) => {
    if (mapInstance) {
      mapInstance.flyTo([lat, lon], 16)
      document.getElementById('map').scrollIntoView({ behavior: 'smooth' })
    }
  }

  // Execute Visit (Called after Confirmation)
  window.executeVisit = async (parroquiaId, parroquiaName, photoPath) => {
    try {
      // Use central helper to get user data
      const user = getUserData()

      console.log('DEBUG: Execute Visit User:', user)

      if (!user || (user.isAuthenticated !== 'true' && user.isAuthenticated !== true)) {
        console.error('Execute Visit Failed: User not authenticated in execution context', user)
        alert('Error: No hay sesión activa detector.')
        return
      }

      // Log info as requested by user
      console.log('--- SI ESTOY AQUI CLICKED (CONFIRMED) ---')
      console.log('User Info:', user)
      console.log('Parroquia:', parroquiaName, parroquiaId)

      // Check if already visited
      const visitedString = user.parroquiasVistitadas || ''
      const visitedIds = visitedString.split(',').map((id) => id.trim())
      const targetId = (parroquiaId || parroquiaName).toString()

      if (visitedIds.includes(targetId) || confirmedParishes.has(targetId)) {
        // Show Already Visited Modal
        const modal = document.getElementById('already-visited-modal')
        if (modal) {
          modal.classList.remove('hidden')
          // Close logic
          document.getElementById('btn-close-visited').onclick = () => {
            modal.classList.add('hidden')
          }
        } else {
          alert('¡Ya has visitado esta parroquia! Sigue explorando otras.')
        }
        return // STOP execution
      }

      // 1. Mark as confirmed locally (Optimistic)
      confirmedParishes.add(parroquiaId || parroquiaName)

      // 2. Call API
      const response = await fetch('/api/visit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          userId: user.docId,
          parroquiaId: parroquiaId,
          userLogInfo: user,
          photoPath: photoPath,
        }),
      })

      const result = await response.json()

      if (result.success) {
        // 3. Show Success Animation & Confetti
        showSuccessAnimation()
        confetti({
          particleCount: 150,
          spread: 70,
          origin: { y: 0.6 },
          colors: ['#f8b134', '#ffffff', '#bf8418'],
          zIndex: 10000,
        })

        // Find the specific parish in local data to be absolutely sure about the reward
        let localReward = result.pointsAwarded || 10
        if (typeof locations !== 'undefined') {
          const foundParish = locations.find((l) => l.id == parroquiaId)
          if (foundParish && foundParish.reward) {
            localReward = parseInt(foundParish.reward)
          }
        }

        // Show Points Notification
        const pointsModal = document.getElementById('points-notification')
        const pointsContainer = document.getElementById('points-container')
        const pointsText = document.getElementById('points-amount')

        if (pointsModal && pointsText && pointsContainer) {
          pointsText.textContent = `+${localReward}`
          pointsModal.classList.remove('hidden')

          // Trigger animation frame
          requestAnimationFrame(() => {
            pointsContainer.setAttribute('data-show', 'true')
          })

          setTimeout(() => {
            pointsContainer.removeAttribute('data-show')
            setTimeout(() => {
              pointsModal.classList.add('hidden')
            }, 300) // Wait for scale down
          }, 3000)
        }

        // 4. Update User Data (OPTIMISTIC & Immediate)
        const newScore = parseInt(user.score || 0) + localReward
        const newVisited =
          (user.parroquiasVistitadas || '') + (user.parroquiasVistitadas ? ',' : '') + parroquiaId

        const optimisitcUser = {
          ...user,
          score: newScore.toString(),
          parroquiasVistitadas: newVisited,
        }

        // Update global stores immediately
        if (window.bartimeoUserStore) {
          window.bartimeoUserStore.set(optimisitcUser)
        }
        import('../store/userStore').then(({ userStore }) => {
          userStore.set(optimisitcUser)
        })

        // Still call refresh to get any server-side validation eventually (Specific User Only)
        await fetchAndRefeshSingleUser(user.docId)
      } else {
        console.error('Visit API failed:', result.error)

        if (result.code === 'DUPLICATE_VISIT') {
          // Show Already Visited Modal
          const modal = document.getElementById('already-visited-modal')
          if (modal) {
            modal.classList.remove('hidden')
            document.getElementById('btn-close-visited').onclick = () => {
              modal.classList.add('hidden')
            }
          }
        } else {
          alert('Hubo un error registrando tu visita. Intenta de nuevo.')
        }
        confirmedParishes.delete(parroquiaId || parroquiaName)
      }
    } catch (e) {
      console.error('Execute Visit Error:', e)
      //alert('Error de conexión - Contacta a 3123415728')
      confirmedParishes.delete(parroquiaId || parroquiaName)
    }
  }

  // Triggered by User Interaction (Popup Button or Floating Button)
  window.validateAndConfirm = (parroquiaId, parroquiaName) => {
    // 1. Find Location Data
    const loc = locations.find((l) => (l.id || l.name) === parroquiaId || l.name === parroquiaName)
    if (!loc) return

    // 2. Check Distance
    if (!userCoords.lat) {
      alert('Necesitamos tu ubicación para confirmar.')
      startLocationTracking()
      return
    }

    const dKm = calculateDistance(
      userCoords.lat,
      userCoords.lon,
      loc.center?.lat || loc.lat,
      loc.center?.lng || loc.lng
    )
    const dMeters = dKm * 1000

    if (dMeters <= PROXIMITY_THRESHOLD_M) {
      // Success: Show Confirmation Modal
      showProximityModal(loc, parroquiaId)
    } else {
      // Failure: Show Distance Warning
      showDistanceModal(dMeters)
    }
  }

  function showDistanceModal(meters) {
    const modal = document.getElementById('distance-modal')
    const val = document.getElementById('distance-value')
    const btn = document.getElementById('btn-close-distance')

    if (modal && val) {
      val.textContent = meters.toFixed(0) + 'm'
      modal.classList.remove('hidden')
      btn.onclick = () => modal.classList.add('hidden')
    }
  }

  function checkProximity(lat, lon) {
    const inRangeLocation = locations.find((loc) => {
      const pid = loc.id || loc.parroquiaid || loc.name
      // If confirmed, treat as "visited" (don't auto-trigger new visit logic for it)
      if (confirmedParishes.has(pid)) return false

      const dKm = calculateDistance(
        lat,
        lon,
        loc.center?.lat || loc.lat,
        loc.center?.lng || loc.lng
      )
      const dMeters = dKm * 1000
      return dMeters <= PROXIMITY_THRESHOLD_M
    })

    // Update State
    currentProximityLoc = inRangeLocation || null

    if (currentProximityLoc) {
      const pid = currentProximityLoc.id || currentProximityLoc.name

      // 1. Auto-Open Modal on First Detection
      if (!hasShownInitialModal) {
        showProximityModal(currentProximityLoc, pid)
        hasShownInitialModal = true // Only once per session/page load
      }
    }

    // 2. Update Floating Button Visibility
    updateFloatingButton()
  }

  function updateFloatingButton() {
    const floatingBtn = document.getElementById('floating-confirm-btn')
    const floatingName = document.getElementById('floating-parish-name')

    if (!floatingBtn) return

    // Logic: Show ONLY if in range AND popup is NOT open
    // (And logically not confirmed, which is handled by checkProximity returning null for confirmed ones)
    if (currentProximityLoc && !isPopupOpen) {
      const pid = currentProximityLoc.id || currentProximityLoc.name
      floatingBtn.classList.remove('hidden')

      // Ensure click handler
      floatingBtn.onclick = () => window.validateAndConfirm(pid, currentProximityLoc.name)
      if (floatingName) floatingName.textContent = currentProximityLoc.name
    } else {
      floatingBtn.classList.add('hidden')
    }
  }

  function showProximityModal(loc, pid) {
    if (!isUserLoggedIn()) {
      showLoginRequiredModal()
      return
    }

    const user = getUserData()
    if (!user) return

    const visitedString = user.parroquiasVistitadas || ''
    const visitedIds = visitedString.split(',').map((id) => id.trim())
    const targetId = (pid || loc.name).toString()

    if (visitedIds.includes(targetId) || confirmedParishes.has(targetId)) {
      const visitedModal = document.getElementById('already-visited-modal')
      if (visitedModal) {
        visitedModal.classList.remove('hidden')
        const closeBtn = document.getElementById('btn-close-visited')
        if (closeBtn) {
          closeBtn.onclick = () => {
            visitedModal.classList.add('hidden')
          }
        }
      } else {
        alert('¡Ya has visitado esta parroquia!')
      }
      return
    }

    const modal = document.getElementById('proximity-modal')
    if (modal.classList.contains('hidden')) {
      const nameEl = document.getElementById('modal-parish-name')
      if (nameEl) nameEl.textContent = loc.name
      modal.classList.remove('hidden')

      // reset input state
      const fileInput = document.getElementById('photo-upload-input')
      if (fileInput) fileInput.value = ''
      const selectedName = document.getElementById('file-selected-name')
      if (selectedName) selectedName.classList.add('hidden')

      const btnConfirm = document.getElementById('btn-confirm-arrival')
      const btnCancel = document.getElementById('btn-cancel-arrival')

      if (btnConfirm && btnCancel) {
        btnConfirm.onclick = async () => {
          // Redundant safely check
          if (!isUserLoggedIn()) {
            modal.classList.add('hidden')
            showLoginRequiredModal()
            return
          }

          const user = getUserData()
          if (!user) {
            alert('Error obteniendo datos del usuario')
            return
          }

          const fileInput = document.getElementById('photo-upload-input')
          const file = fileInput.files?.[0]

          if (!file) {
            alert('Por favor selecciona o toma una foto para confirmar tu visita.')
            return
          }

          // Bloquear boton
          btnConfirm.disabled = true
          btnConfirm.textContent = 'Subiendo...'
          btnCancel.disabled = true

          const statusDiv = document.getElementById('upload-status')
          const progressSpan = document.getElementById('upload-progress')
          if (statusDiv) statusDiv.classList.remove('hidden')

          try {
            // Upload photo
            const validExtensions = ['jpg', 'jpeg', 'png', 'webp', 'heic', 'heif']
            const fileExtension = file.name.split('.').pop()?.toLowerCase() || ''
            if (!validExtensions.includes(fileExtension)) {
              throw new Error('Solo se permiten archivos de imagen.')
            }

            // Using comprobantes/ directory to bypass strict Firebase Storage rules for /visitas
            // since users are not authenticated via standard Firebase Auth mechanism
            const storagePath = `visitas/visita_${pid}_${user.docId}_${Date.now()}.${fileExtension}`
            const storageRef = ref(storage, storagePath)

            const uploadTask = uploadBytesResumable(storageRef, file)

            uploadTask.on(
              'state_changed',
              (snapshot) => {
                const progress = Math.round((snapshot.bytesTransferred / snapshot.totalBytes) * 100)
                if (progressSpan) progressSpan.textContent = progress + '%'
              },
              (error) => {
                console.error('Error subiendo imagen:', error)
                alert('Hubo un error al subir la imagen.')
                btnConfirm.disabled = false
                btnConfirm.textContent = '¡Sí, estoy aquí!'
                btnCancel.disabled = false
                if (statusDiv) statusDiv.classList.add('hidden')
              },
              async () => {
                // Success
                const downloadURL = await getDownloadURL(uploadTask.snapshot.ref)

                window.executeVisit(pid, loc.name, downloadURL)

                // Reset modal state
                modal.classList.add('hidden')
                btnConfirm.disabled = false
                btnConfirm.textContent = '¡Sí, estoy aquí!'
                btnCancel.disabled = false
                if (statusDiv) statusDiv.classList.add('hidden')
                fileInput.value = ''
              }
            )
          } catch (error) {
            alert(error.message || 'Error al procesar la imagen')
            btnConfirm.disabled = false
            btnConfirm.textContent = '¡Sí, estoy aquí!'
            btnCancel.disabled = false
            if (statusDiv) statusDiv.classList.add('hidden')
          }
        }
        btnCancel.onclick = () => {
          modal.classList.add('hidden')
        }
      }
    }
  }

  async function fetchAndRefeshSingleUser(userId) {
    if (!userId) return

    try {
      console.log('Fetching fresh data for user:', userId)
      const res = await fetch(`/api/user/${userId}`)
      if (!res.ok) throw new Error('Failed to fetch specific user')

      const freshUser = await res.json()

      // Update Stores
      if (window.bartimeoUserStore) {
        window.bartimeoUserStore.set(freshUser)
      }
      import('../store/userStore').then(({ userStore }) => {
        userStore.set(freshUser)
      })

      console.log('Successfully refreshed single user data from Firestore')
    } catch (e) {
      console.error('Error refreshing single user:', e)
    }
  }

  function getUserData() {
    try {
      if (window.bartimeoUserStore) {
        return window.bartimeoUserStore.get()
      }
      // Fallback
      if (typeof userStore !== 'undefined') {
        return userStore.get()
      }
      return null
    } catch (e) {
      return null
    }
  }

  function isUserLoggedIn() {
    const user = getUserData()
    if (!user) return false
    return user.isAuthenticated === 'true' || user.isAuthenticated === true
  }

  function showLoginRequiredModal() {
    const modal = document.getElementById('login-required-modal')
    if (modal) {
      modal.classList.remove('hidden')

      const btnLogin = document.getElementById('btn-trigger-login')
      const btnCancel = document.getElementById('btn-cancel-login')

      if (btnLogin)
        btnLogin.onclick = () => {
          modal.classList.add('hidden')
          // Try global trigger first (more reliable across island boundaries)
          if ((window as any).openLoginModule) {
            ;(window as any).openLoginModule()
          } else {
            isLoginOpen.set(true)
          }
        }
      if (btnCancel)
        btnCancel.onclick = () => {
          modal.classList.add('hidden')
        }
    }
  }

  function showSuccessAnimation() {
    const overlay = document.getElementById('success-overlay')
    if (!overlay) return

    overlay.classList.remove('hidden')

    // Auto close or manual close
    const closeBtn = document.getElementById('btn-close-success')
    if (closeBtn) {
      closeBtn.onclick = () => {
        overlay.classList.add('hidden')
      }
    }

    // Optional: Auto hide after 5s
    setTimeout(() => overlay.classList.add('hidden'), 5000)
  }

  function setupUIControls() {
    // Search Functionality
    const searchInput = document.getElementById('parish-search')
    const searchResults = document.getElementById('search-results')

    if (searchInput && searchResults) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim()
        if (query.length < 2) {
          searchResults.classList.add('hidden')
          return
        }

        const matches = locations.filter(
          (loc) =>
            loc.name.toLowerCase().includes(query) ||
            (loc.vicaria && loc.vicaria.toLowerCase().includes(query))
        )

        if (matches.length > 0) {
          searchResults.innerHTML = matches
            .slice(0, 5) // Limit results
            .map(
              (loc) => `
                <div 
                  class="p-3 hover:bg-gray-50 cursor-pointer flex items-center gap-3 transition-colors"
                  onclick="window.flyToParish('${loc.id || loc.name}', ${loc.center?.lat || loc.lat}, ${loc.center?.lng || loc.lng})"
                >
                   <div class="w-2 h-2 rounded-full bg-[#f8b134]"></div>
                   <div>
                     <p class="text-sm font-bold text-gray-800 leading-tight">${loc.name}</p>
                     <p class="text-[10px] text-gray-500 uppercase">${loc.vicaria || 'Parroquia'}</p>
                   </div>
                </div>
            `
            )
            .join('')
          searchResults.classList.remove('hidden')
        } else {
          searchResults.innerHTML = `<div class="p-4 text-center text-xs text-gray-400">No se encontraron resultados</div>`
          searchResults.classList.remove('hidden')
        }
      })

      // Hide on click outside
      document.addEventListener('click', (e) => {
        if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
          searchResults.classList.add('hidden')
        }
      })
    }

    // My Location
    document.getElementById('btn-location').addEventListener('click', () => {
      if (userCoords.lat) {
        mapInstance.flyTo([userCoords.lat, userCoords.lon], 16)
      } else {
        startLocationTracking() // Trigger ask permission
      }
    })

    // Refresh
    document.getElementById('btn-refresh').addEventListener('click', () => {
      // Force manual update
      if ('geolocation' in navigator) {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            updateUserLocation(pos.coords.latitude, pos.coords.longitude)
            mapInstance.flyTo([pos.coords.latitude, pos.coords.longitude], mapInstance.getZoom())
          },
          (err) => alert('Error al actualizar ubicación.')
        )
      }
    })

    // Collapsible Nearby List
    const nearbyHeader = document.getElementById('nearby-header')
    const nearbyList = document.getElementById('nearby-list')
    const nearbyChevron = document.getElementById('nearby-chevron')

    if (nearbyHeader && nearbyList && nearbyChevron) {
      nearbyHeader.addEventListener('click', () => {
        nearbyList.classList.toggle('hidden')
        nearbyChevron.classList.toggle('rotate-180')
      })
    }

    // Photo Upload Input Listener
    const photoInput = document.getElementById('photo-upload-input')
    const photoNameDisplay = document.getElementById('file-selected-name')
    const photoNameText = document.getElementById('file-selected-text')

    if (photoInput && photoNameDisplay && photoNameText) {
      photoInput.addEventListener('change', (e) => {
        const files = e.target.files
        if (files && files.length > 0) {
          photoNameText.textContent = 'Evidencia: ' + files[0].name
          photoNameDisplay.classList.remove('hidden')
        } else {
          photoNameDisplay.classList.add('hidden')
        }
      })
    }
  }

  // Updated FlyTo to also open popup if ID provided
  window.flyToParish = (idOrLat, latOrLon, lonOrNull) => {
    let lat, lon, id

    // Overload handling: (lat, lon) or (id, lat, lon)
    if (typeof idOrLat === 'string') {
      id = idOrLat
      lat = latOrLon
      lon = lonOrNull
    } else {
      lat = idOrLat
      lon = latOrLon
    }

    if (mapInstance && lat && lon) {
      mapInstance.flyTo([lat, lon], 17) // Zoom in closer

      // Simple way to open popup if we had a marker reference map,
      // but since we restart markers, we rely on user seeing the centered marker.
      // Alternatively, we could search layers if needed, but FlyTo is usually enough UX.
      document.getElementById('map').scrollIntoView({ behavior: 'smooth' })

      // Clear search
      const input = document.getElementById('parish-search')
      const results = document.getElementById('search-results')
      if (input) input.value = ''
      if (results) results.classList.add('hidden')
    }
  }

  // Haversine Formula
  function calculateDistance(lat1, lon1, lat2, lon2) {
    const R = 6371 // Earth radius km
    const dLat = deg2rad(lat2 - lat1)
    const dLon = deg2rad(lon2 - lon1)
    const a =
      Math.sin(dLat / 2) * Math.sin(dLat / 2) +
      Math.cos(deg2rad(lat1)) * Math.cos(deg2rad(lat2)) * Math.sin(dLon / 2) * Math.sin(dLon / 2)
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))
    return R * c
  }

  function deg2rad(deg) {
    return deg * (Math.PI / 180)
  }

  function getColorForVicaria(vicaria) {
    if (!vicaria) return colors.default
    const v = vicaria.toLowerCase()
    for (const key in colors) {
      if (v.includes(key)) return colors[key]
    }
    return colors.default
  }
  function setupMapInteractions() {
    if (!$mapElement) return

    const triggerLocation = () => {
      // Only request if we haven't started watching yet
      if (!watchId) {
        startLocationTracking()
      }
    }

    // Add listeners to map container
    $mapElement.addEventListener('click', triggerLocation, { once: true })
    $mapElement.addEventListener('touchstart', triggerLocation, { once: true })

    // Also Leaflet map instance events if initialized
    if (mapInstance) {
      mapInstance.on('click', triggerLocation)
      mapInstance.on('dragstart', triggerLocation)
    }
  }
</script>

