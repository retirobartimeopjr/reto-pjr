---
import LoginOverlay from './LoginOverlay.astro'

interface Props {
  isLocked: boolean
}

const { isLocked } = Astro.props

const ranking = [
  { name: 'Juan Pérez', points: 2400, rank: 1 },
  { name: 'María G.', points: 2150, rank: 2 },
  { name: 'Carlos R.', points: 1900, rank: 3 },
  { name: 'Ana Torres', points: 1850, rank: 4 },
  { name: 'Luis M.', points: 1720, rank: 5 },
]
---

<section class="max-w-md w-full mx-auto mt-6">
  <div
    class="bg-black/20 backdrop-blur-md border border-white/10 rounded-2xl p-6 relative overflow-hidden h-72"
  >
    <h3 class="text-xl font-serif font-bold text-[#f8b134] mb-4 text-center">Ranking General</h3>

    <LoginOverlay isLocked={isLocked}>
      <div class="flex flex-col gap-2">
        {
          ranking.map((user) => (
            <div
              class={`flex items-center justify-between p-2 rounded-lg ${user.rank === 1 ? 'bg-gradient-to-r from-[#f8b134]/20 to-transparent border border-[#f8b134]/30' : 'bg-white/5 border border-white/5'}`}
            >
              <div class="flex items-center gap-3">
                <span
                  class={`font-mono font-bold w-6 h-6 flex items-center justify-center rounded-full text-xs ${user.rank <= 3 ? 'bg-[#f8b134] text-[#640010]' : 'bg-white/10 text-white/70'}`}
                >
                  {user.rank}
                </span>
                <span class="text-sm font-sans text-white/90">{user.name}</span>
              </div>
              <span class="text-xs font-mono text-[#f8b134]">{user.points} pts</span>
            </div>
          ))
        }
      </div>
    </LoginOverlay>
  </div>
</section>
